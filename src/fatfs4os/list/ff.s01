; 667.	
; 668.	/*-----------------------------------------------------------------------*/
; 669.	/* Change window offset                                                  */
; 670.	/*-----------------------------------------------------------------------*/
; 671.	
; 672.	static
; 673.	FRESULT move_window (
; 674.	    FATFS *fs,      /* File system object */
; 675.	    DWORD sector    /* Sector number to make appearance in the fs->win[] */
; 676.	)                   /* Move to zero only writes back dirty window */
move_window:
	CALL	?ENT_AUTO_DIRECT_L09
	DEFW	65530
	PUSH	IY
	LD	L,(IX+2)
	LD	H,(IX+3)
	PUSH	HL
	POP	IY
; 677.	{
; 678.	    DWORD wsect;
; 679.	
; 680.	
	LD	C,(IY+49)
	LD	B,(IY+50)
	LD	L,(IY+47)
	LD	H,(IY+48)
	LD	(IX-6),L
	LD	(IX-5),H
	LD	(IX-4),C
	LD	(IX-3),B
; 681.	    wsect = fs->winsect;
	LD	E,C
	LD	D,B
	LD	C,(IX+8)
	LD	B,(IX+9)
	AND	A
	SBC	HL,BC
	JR	NZ,?1128
	EX	DE,HL
	LD	C,(IX+10)
	LD	B,(IX+11)
	SBC	HL,BC
	JP	Z,?0017
?1128:
?0004:
; 682.	    if (wsect != sector) {  /* Changed current window */
; 683.	#if !_FS_READONLY
	LD	A,(IY+5)
	OR	A
	JP	Z,?0012
?0006:
; 684.	        if (fs->wflag) {    /* Write back dirty window if needed */
	LD	A,(IY+1)
	LD	(drv_calls+26),A
	LD	HL,51
	PUSH	IY
	POP	BC
	ADD	HL,BC
	LD	(drv_calls+27),HL
	LD	HL,2
	ADD	HL,SP
; 685.	            SET_DIO_PAR(fs->drv, fs->win, wsect,1);
	CALL	?1290
	JP	NZ,?1129
?0008:
; 686.	            if (drv_calls.write_from_buf() != RES_OK)
; 687.	                return FR_DISK_ERR;
?0009:
	LD	(IY+5),A
; 688.	            fs->wflag = 0;
	LD	L,(IY+33)
	LD	H,(IY+34)
	PUSH	HL
	LD	L,(IY+31)
	LD	H,(IY+32)
	PUSH	HL
	LD	L,(IY+35)
	LD	H,(IY+36)
	POP	BC
	ADD	HL,BC
	EX	DE,HL
	LD	L,(IY+37)
	LD	H,(IY+38)
	POP	BC
	ADC	HL,BC
	PUSH	HL
	PUSH	DE
	AND	A
	LD	L,(IX-6)
	LD	H,(IX-5)
	POP	BC
	SBC	HL,BC
