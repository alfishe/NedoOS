 236+ 0000              ;*********************** OS_SETDTA **********************
 237+ 0000              ;Установить адрес передачи данных для следующей команды CP/M.
 238+ 0000              ;    Все аргументы в регистрах:
 239+ 0000              ;        DE - адрес передачи данных.
 240+ 0000              ;    Возвращаемых значений нет.
 241+ 0000                      macro OS_SETDTA ;DE = data transfer address (DTA)
 242+ 0000 ~                    ld c,CMD_SETDTA
 243+ 0000 ~                    CALLBDOS_NOPARAM_A
 244+ 0000                      endm
 245+ 0000              ;*********************** OS_FSEARCHFIRST **********************
 246+ 0000              ;Прочитать первый элемент текущей директории (файл или каталог).
 247+ 0000              ;Последующие элементы директории надо считывать командой OS_FSEARCHNEXT.
 248+ 0000              ;Вся информация о файле или каталоге будет записана в FCB по адресу, установленному командой SET_DTA (этот адрес меняется после выполнения команды!).
 249+ 0000              ;Полученную FCB можно будет открыть командой OS_FOPEN.
 250+ 0000              ;Если возвращена ошибка, то ничего не записывается и адрес не сдвигается.
 251+ 0000              ;    Все аргументы в регистрах:
 252+ 0000              ;        DE - адрес FCB с маской имени файла или каталога (знак '?' в ней означает любой символ в имени).
 253+ 0000              ;    Возвращаемые значения в регистрах:
 254+ 0000              ;        A - код ошибки (если 0, то ошибки нет). Окончание директории - это ошибка.
 255+ 0000              ;
 256+ 0000              ;Примечания:
 257+ 0000              ;NedoOS не проверяет номер экстента в FCB с маской.
 258+ 0000              ;В NedoOS атрибуты файла возвращаются в обычном месте (не в поле S1).
 259+ 0000              ;NedoOS не возвращает этой командой метку диска и date stamps.
 260+ 0000              ;NedoOS не пропускает скрытые и системные файлы.
 261+ 0000              ;NedoOS не возвращает коды ошибки в регистрах H,L,C.
 262+ 0000              ;В NedoOS выходное значение A = 1..3 считается ошибкой.
 263+ 0000                      macro OS_FSEARCHFIRST ;de = pointer to unopened FCB (filename with ????????), read matching FCB to DTA. DTA had to set every time
 264+ 0000 ~                    ld c,CMD_FSEARCHFIRST
 265+ 0000 ~                    CALLBDOS_NOPARAM_A
 266+ 0000                      endm
 267+ 0000
 268+ 0000              ;*********************** OS_FSEARCHNEXT **********************
 269+ 0000              ;Прочитать очередной (не первый) элемент текущей директории (файл или каталог).
 270+ 0000              ;Вся информация о файле или каталоге будет записана в FCB по адресу, установленному командой SET_DTA (этот адрес меняется после выполнения команды!).
 271+ 0000              ;Полученную FCB можно будет открыть командой OS_FOPEN.
 272+ 0000              ;Если возвращена ошибка, то ничего не записывается и адрес не сдвигается.
 273+ 0000              ;    Все аргументы в регистрах:
 274+ 0000              ;        DE - адрес FCB с маской имени файла или каталога (знак '?' в ней означает любой символ в имени).
 275+ 0000              ;    Возвращаемые значения в регистрах:
 276+ 0000              ;        A - код ошибки (если 0, то ошибки нет). Окончание директории - это ошибка.
 277+ 0000              ;
 278+ 0000              ;Примечание: в отличие от CP/M, нужно обязательно передавать адрес маски!
 279+ 0000              ;См. также примечания к OS_FSEARCHFIRST!
 280+ 0000                      macro OS_FSEARCHNEXT ;(NOT CP/M compatible!!!)de = pointer to unopened FCB (filename with ????????), read matching FCB to DTA. DTA had to set every time
 281+ 0000 ~                    ld c,CMD_FSEARCHNEXT
 282+ 0000 ~                    CALLBDOS_NOPARAM_A
 283+ 0000                      endm
 284+ 0000
 285+ 0000              ;Нижеследующие вызовы CP/M пользовать не рекомендуется!
 286+ 0000              ;from CP/M (try to avoid use!)
 287+ 0000                      ;macro OS_PRCHAR ;e=char
 288+ 0000                      ;ld c,CMD_PRCHAR
 289+ 0000                      ;CALLBDOS_NOPARAM_A
 290+ 0000                      ;endm
 291+ 0000                      macro OS_SETDRV ;e=drive ;out: a!=0 => not mounted, [l=number of drives]
 292+ 0000 ~                    ld c,CMD_SETDRV
 293+ 0000 ~                    CALLBDOS_NOPARAM_A
 294+ 0000                      endm
 295+ 0000                      macro OS_FOPEN ;de = pointer to unopened FCB
 296+ 0000 ~                    ld c,CMD_FOPEN
 297+ 0000 ~                    CALLBDOS_NOPARAM_A
 298+ 0000                      endm
 299+ 0000                      macro OS_FCLOSE ;de = pointer to opened FCB
 300+ 0000 ~                    ld c,CMD_FCLOSE
 301+ 0000 ~                    CALLBDOS_NOPARAM_A
 302+ 0000                      endm
 303+ 0000                      macro OS_FDEL ;DEPRECATED!!!!! ;DE = Pointer to unopened FCB
 304+ 0000 ~                    ld c,CMD_FDEL
 305+ 0000 ~                    CALLBDOS_NOPARAM_A
 306+ 0000                      endm
 307+ 0000                      macro OS_FREAD ;DE = Pointer to opened FCB, read 128 bytes in DTA, out: a=128^bytes actually read (not CP/M!)
 308+ 0000 ~                    ld c,CMD_FREAD
