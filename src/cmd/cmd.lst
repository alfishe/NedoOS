   3+ 0000
   4+ 0000              ;*********************** QUIT **********************
   5+ 0000              ;Закрывает текущий процесс, освобождая все используемые им страницы ОЗУ,
   6+ 0000              ;дескрипторы сокетов и файлов (кроме пайпов и TR-DOS'ных файлов), а также обработчик музыки.
   7+ 0000              ;Переключает исполнение и фокус видеовывода на следующий активный процесс.
   8+ 0000              ;    Аргумент: hl=результат программы (родитель его получает по WAITPID).
   9+ 0000              ;    Возвращаемых значений нет.
  10+ 0000              ;
  11+ 0000              ;Пример использования, а также минимальный исходный код программы:
  12+ 0000              ;        DEVICE ZXSPECTRUM128
  13+ 0000              ;        include "../_sdk/sys_h.asm"
  14+ 0000              ;        ORG PROGSTART
  15+ 0000              ;        ;исходный код программы
  16+ 0000              ;        ld hl,0 ;result
  17+ 0000              ;        QUIT
  18+ 0000              ;        savebin "progname.com",PROGSTART,$-PROGSTART
  19+ 0000                      macro QUIT
  20+ 0000 ~                    rst 0 ;close app
  21+ 0000                      endm
  22+ 0000
  23+ 0000              ;*********************** CALLBDOS, CALLBDOS_NOPARAM_A **********************
  24+ 0000              ;Внутренние макросы для вызова функций системы.
  25+ 0000              ;(CALLBDOS - для функций системы, имеющих параметр в регистре A)
  26+ 0000              ;(CALLBDOS_NOPARAM_A - для функций системы, не имеющих параметра в регистре A)
  27+ 0000              ;Напрямую использовать не рекомендуется, см. макросы для каждой отдельной функции системы.
  28+ 0000                      macro CALLBDOS ;don't use directly CALLBDOS or call BDOS!!!
  29+ 0000 ~                    ex af,af' ;'
  30+ 0000 ~                    call BDOS ;c=CMD
  31+ 0000                      endm
  32+ 0000                      macro CALLBDOS_NOPARAM_A ;don't use directly CALLBDOS or call BDOS!!!
  33+ 0000 ~                    call BDOS ;c=CMD
  34+ 0000                      endm
  35+ 0000
  36+ 0000              ;*********************** OS_GETKEY **********************
  37+ 0000              ;Возвращает нажатую кнопку клавиатуры, кнопки мыши и координаты мыши.
  38+ 0000              ;Фактически чтение происходит только процессом с фокусом. При отсутствии фокуса возвращается
  39+ 0000              ;код символа NOKEY и флаг Z установлен в 0 (т.е. верно условие NZ).
  40+ 0000              ;    Аргументов нет.
  41+ 0000              ;    Возвращаемые значения в регистрах:
  42+ 0000              ;        A - код символа(кнопки). Допустимые коды смотри в 'sysdefs.asm' секция 'Usable key codes'
  43+ 0000              ;        C - код символа(кнопки) без учета текущего языкового модификатора. Как правило, используется для обработки "горячих кнопок"
  44+ 0000              ;        DE - позиция мыши (y,x) (возвращает 0 при отсутствии фокуса)
  45+ 0000              ;        L - кнопки мыши (bits 0(LMB),1(RMB),2(MMB): 0=pressed; bits 7..4=положение колёсика)
  46+ 0000              ;        LX - Kempston joystick (0bP2JFUDLR): 1=pressed, - при отсутствии джойстика 0 (а не 0xff)
  47+ 0000              ;        Флаг Z - если 0(NZ), то отсутствует фокус.
  48+ 0000              ;
  49+ 0000              ;Пример ожидания символа:
  50+ 0000              ;        ORG PROGSTART
  51+ 0000              ;        LD E,6
  52+ 0000              ;        OS_SETGFX
  53+ 0000              ;        ...
  54+ 0000              ;WAIT_LOOP:
  55+ 0000              ;        YIELD    ;отдадим квант времени системе
  56+ 0000              ;        OS_GETKEY
  57+ 0000              ;        OR A
  58+ 0000              ;        JR Z,WAIT_LOOP
  59+ 0000              ;        CP key_esc
  60+ 0000              ;        JP Z,CLOSE_PROC
  61+ 0000              ;        ;получили код символа в A
  62+ 0000              ;        ...
  63+ 0000              ;CLOSE_PROC:
  64+ 0000              ;        QUIT
  65+ 0000              ;
  66+ 0000              ;        Примечание: желательна обработка кода key_esc для завершения программы
  67+ 0000              ;и кода key_redraw для перерисовки экрана при получении фокуса.
  68+ 0000                      macro OS_GETKEY
  69+ 0000 ~                    rst 0x08 ;out: a=key (NOKEY=no key), de=mouse position (y,x), l=mouse buttons (bits 0,1,2: 0=pressed)+mouse wheel (bits 7..4), h=high bits of key|register, bc=keynolang, lx=kempston joystick, nz=no focus (mouse position=0, ignore it!)
  70+ 0000                      endm
  71+ 0000                      macro GET_KEY
  72+ 0000 ~                    OS_GETKEY
  73+ 0000                      endm
