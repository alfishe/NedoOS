 586+ 0000 ~                    ld c,CMD_READDIR
 587+ 0000 ~            	CALLBDOS_NOPARAM_A		;out in A=error(0 - no error, 4 - no more files, other - critical error)
 588+ 0000                      endm
 589+ 0000                      macro OS_HIDEFROMPARENT ;for tasks with their own screen handling ;hl=результат программы (родитель его получает по WAITPID)
 590+ 0000 ~                    ld c,CMD_HIDEFROMPARENT
