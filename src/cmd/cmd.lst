 111+ 0000              ;*********************** SETPG4000 **********************
 112+ 0000              ;Устанавливает страницу номер A в области адресов 0x4000..0x7fff.
 113+ 0000              ;Быстрая функция (не включает контекст ядра).
 114+ 0000              ;    Все аргументы в регистрах:
 115+ 0000              ;        A - номер страницы
 116+ 0000              ;    Возвращаемых значений нет (портится BC, остальные регистры не портятся)
 117+ 0000              ;
 118+ 0000              ;Примечание: не используйте номера страниц, не полученные из системы тем или иным образом
 119+ 0000              ;(вызовы OS_NEWPAGE, OS_GETMAINPAGE, OS_GETMAINPAGES, OS_GETAPPMAINPAGES
 120+ 0000              ;или чтение номеров страниц экрана из user_scr0_low, user_scr0_high, user_scr1_low, user_scr1_high),
 121+ 0000              ;потому что на моделях памяти ATM2 и ATM3 номера страниц различаются!
 122+ 0000              ;
 123+ 0000              ;Примечание 2: для смены страницы в области адресов 0x0000..0x3fff см. OS_SETMAINPAGE
 124+ 0000                      macro SETPG4000
 125+ 0000 ~                    rst 0x18 ;set page "a" in 0x4000 ;spoils BC
 126+ 0000                      endm
 127+ 0000                      macro SETPG16K ;don't use!
 128+ 0000 ~                    SETPG4000
 129+ 0000                      endm
