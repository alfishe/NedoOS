 693+ 0000 ~                    ld c,CMD_WRITESECTORS
 694+ 0000 ~            	CALLBDOS
 695+ 0000                      endm
 696+ 0000                      macro OS_GETFILESIZE ;b=handle, out: dehl=file size
 697+ 0000 ~                    ld c,CMD_GETFILESIZE
 698+ 0000 ~            	CALLBDOS_NOPARAM_A
 699+ 0000                      endm
