  75+ 0000              ;*********************** OS_PRCHAR **********************
  76+ 0000              ;Выводит символ на экран, используется только в текстовом видеорежиме.
  77+ 0000              ;При отсутствии фокуса вывод игнорируется.
  78+ 0000              ;    Все аргументы в регистрах:
  79+ 0000              ;        A - символ (символ '\r'=0x0d = возврат каретки, символ '\n'=0x0a = перевод строки)
  80+ 0000              ;    Возвращаемых значений нет.
  81+ 0000              ;
  82+ 0000              ;Пример печати строки "Hello Work!":
  83+ 0000              ;        DEVICE ZXSPECTRUM128
  84+ 0000              ;        include "../_sdk/sys_h.asm"
  85+ 0000              ;        ORG PROGSTART
  86+ 0000              ;        LD E,6
  87+ 0000              ;        OS_SETGFX
  88+ 0000              ;        LD HL,STR_HELLO
  89+ 0000              ;PRINT_LOOP:
  90+ 0000              ;        LD A,(HL)
  91+ 0000              ;        OR A
  92+ 0000              ;        JR Z,PRINT_LOOP_END
  93+ 0000              ;        PUSH HL
  94+ 0000              ;        OS_PRCHAR
  95+ 0000              ;        POP HL
  96+ 0000              ;        INC HL
  97+ 0000              ;        JR PRINT_LOOP
  98+ 0000              ;PRINT_LOOP_END:
  99+ 0000              ;<wait something to see the screen...>
 100+ 0000              ;        QUIT
 101+ 0000              ;STR_HELLO:
 102+ 0000              ;        DEFB "Hello Work!",0
 103+ 0000              ;        savebin "progname.com",PROGSTART,$-PROGSTART
 104+ 0000                      macro OS_PRCHAR
 105+ 0000 ~                    rst 0x10 ;a=char ;spoils all registers!
 106+ 0000                      endm
 107+ 0000                      macro PRCHAR
 108+ 0000 ~                    OS_PRCHAR
 109+ 0000                      endm
