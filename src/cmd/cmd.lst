 310+ 0000                      endm
 311+ 0000                      macro OS_FWRITE ;DE = Pointer to opened FCB, write 128 bytes from DTA
 312+ 0000 ~                    ld c,CMD_FWRITE
 313+ 0000 ~                    CALLBDOS_NOPARAM_A
 314+ 0000                      endm
 315+ 0000                      macro OS_FCREATE ;DE = Pointer to unopened FCB
 316+ 0000 ~                    ld c,CMD_FCREATE
 317+ 0000 ~                    CALLBDOS_NOPARAM_A
 318+ 0000                      endm
