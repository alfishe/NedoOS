 131+ 0000              ;*********************** SETPG8000 **********************
 132+ 0000              ;Устанавливает страницу номер A в области адресов 0x8000..0xbfff.
 133+ 0000              ;Быстрая функция (не включает контекст ядра).
 134+ 0000              ;    Все аргументы в регистрах:
 135+ 0000              ;        A - номер страницы
 136+ 0000              ;    Возвращаемых значений нет (портится BC, остальные регистры не портятся)
 137+ 0000              ;
 138+ 0000              ;См. примечания к SETPG4000!
 139+ 0000                      macro SETPG8000
 140+ 0000 ~                    rst 0x20 ;set page "a" in 0x8000 ;spoils BC
 141+ 0000                      endm
 142+ 0000                      macro SETPG32KLOW ;don't use!
 143+ 0000 ~                    SETPG8000
 144+ 0000                      endm
