 218+ 0000              ;*********************** WAITPID **********************
 219+ 0000              ;Ожидание завершения дочернего процесса.
 220+ 0000              ;    Аргумент: E - PID
 221+ 0000              ;    Возвращаемые значения в регистрах:
 222+ 0000              ;        HL - результат, который вернул дочерний процесс
 223+ 0000              ;Как это работает:
 224+ 0000              ;OS_SETWAITING замораживает текущий процесс, а YIELD передаёт время системе.
 225+ 0000              ;Текущий процесс получит управление только тогда, когда дочерний процесс завершится или сделает OS_HIDEFROMPARENT
 226+ 0000              ;(он автоматически размораживает родителя и записывает childresult в структуру родителя).
 227+ 0000                      macro WAITPID
 228+ 0000 ~                    OS_SETWAITING ;не замораживает, если дочерний процесс уже завершился
 229+ 0000 ~                    YIELD
 230+ 0000 ~                    ld c,CMD_GETCHILDRESULT
 231+ 0000 ~            	CALLBDOS_NOPARAM_A ;hl=result
 232+ 0000                      endm
