 320+ 0000              ;======================= from MSX-DOS: =============================
 321+ 0000
 322+ 0000              ;*********************** OS_OPENHANDLE **********************
 323+ 0000              ;Открывает существующий файл для чтения/записи.
 324+ 0000              ;    Все аргументы в регистрах:
 325+ 0000              ;        DE - строка с именем файла, может содержать относительный или абсолютный путь к файлу.
 326+ 0000              ;            в текущей реализации поддержан формат имен 8.3
 327+ 0000              ;    Возвращаемые значения в регистрах:
 328+ 0000              ;        А - ошибка. Если 0x00, то ошибки нет.
 329+ 0000              ;        B - хэндл файла, если нет ошибки.
 330+ 0000              ;
 331+ 0000              ;Пример открытия файла "pyraster.txt", расположенного в директории "../fu/ckco":
 332+ 0000              ;        ...
 333+ 0000              ;        LD DE,FILE_NAME
 334+ 0000              ;        OS_OPENHANDLE
 335+ 0000              ;        OR A
 336+ 0000              ;        JP NZ,ERR_EXIT    ;обработка ошибок
 337+ 0000              ;        LD A,B
 338+ 0000              ;        LD (FILE),A    ;сохраняем дескриптор
 339+ 0000              ;        ...
 340+ 0000              ;FILE_NAME:
 341+ 0000              ;        DEFB "../fu/ckco/pyraster.txt",0
 342+ 0000              ;        ...
 343+ 0000              ;
 344+ 0000              ;Примечания:
 345+ 0000              ;Необходимо закрывать все открытые файлы.
 346+ 0000              ;Также желательно закрыть файл, как только он становится не нужен для чтения/записи.
 347+ 0000              ;При открытии файла указатель чтения/записи этого файла устанавливается на первый байт в файле.
 348+ 0000                      macro OS_OPENHANDLE ;DE = Drive/path/file ASCIIZ string ;out: B = new file handle, A=error
 349+ 0000 ~                    ld c,CMD_OPENHANDLE
 350+ 0000 ~                    CALLBDOS_NOPARAM_A
 351+ 0000                      endm
 352+ 0000
 353+ 0000              ;*********************** OS_CREATEHANDLE **********************
 354+ 0000              ;Создать и открыть файл для чтения/записи.
 355+ 0000              ;    Все аргументы в регистрах:
 356+ 0000              ;        DE - строка с именем файла, может содержать относительный или абсолютный путь к файлу.
 357+ 0000              ;            в текущей реализации поддержан формат имен 8.3
 358+ 0000              ;    Возвращаемые значения в регистрах:
 359+ 0000              ;        А - ошибка. Если 0x00, то ошибки нет.
 360+ 0000              ;        B - хэндл файла, если нет ошибки.
 361+ 0000              ;
 362+ 0000              ;Пример создания файла "pyraster.txt", расположенного в директории "../fu/ckco":
 363+ 0000              ;        ...
 364+ 0000              ;        LD DE,FILE_NAME
 365+ 0000              ;        OS_CREATEHANDLE
 366+ 0000              ;        OR A
 367+ 0000              ;        JP NZ,ERR_EXIT    ;обработка ошибок
 368+ 0000              ;        LD A,B
 369+ 0000              ;        LD (FILE),A    ;сохраняем дескриптор
 370+ 0000              ;        ...
 371+ 0000              ;FILE_NAME:
 372+ 0000              ;        DEFB "../fu/ckco/pyraster.txt",0
 373+ 0000              ;        ...
 374+ 0000              ;
 375+ 0000              ;Примечания:
 376+ 0000              ;Необходимо закрывать все открытые файлы.
 377+ 0000              ;Также желательно закрыть файл, как только он становится не нужен для чтения/записи.
 378+ 0000              ;При создании файла указатель чтения/записи этого файла устанавливается на первый байт в файле.
 379+ 0000              ;Не рекомендуется читать файл, открытый через OS_CREATEHANDLE! Лучше закройте его и откройте через OS_OPENHANDLE.
 380+ 0000                      macro OS_CREATEHANDLE ;DE = Drive/path/file ASCIIZ string ;out: B = new file handle, A=error
 381+ 0000 ~                    ld c,CMD_CREATEHANDLE
 382+ 0000 ~                    CALLBDOS_NOPARAM_A
 383+ 0000                      endm
 384+ 0000
 385+ 0000              ;*********************** OS_CLOSEHANDLE **********************
 386+ 0000              ;Закрывает открытый файл.
 387+ 0000              ;    Все аргументы в регистрах:
 388+ 0000              ;        B - хэндл файла.
 389+ 0000              ;    Возвращаемые значения в регистрах:
 390+ 0000              ;        А - ошибка. Если 0x00, то ошибки нет.
 391+ 0000              ;
 392+ 0000              ;Пример закрытия файла:
 393+ 0000              ;        ...
 394+ 0000              ;        LD A,(FILE)
 395+ 0000              ;        LD B,A
 396+ 0000              ;        OS_CLOSEHANDLE
 397+ 0000              ;        OR A
 398+ 0000              ;        JP NZ,ERR_EXIT    ;обработка ошибок
 399+ 0000              ;        ...
 400+ 0000              ;
 401+ 0000              ;Примечания:
 402+ 0000              ;Необходимо закрывать все открытые файлы.
 403+ 0000              ;Также желательно закрыть файл, как только он становится не нужен для чтения/записи.
 404+ 0000                      macro OS_CLOSEHANDLE ;B = file handle, out: A=error
 405+ 0000 ~                    ld c,CMD_CLOSEHANDLE
 406+ 0000 ~                    CALLBDOS_NOPARAM_A
 407+ 0000                      endm
 408+ 0000
 409+ 0000              ;*********************** OS_READHANDLE **********************
 410+ 0000              ;Читает массив байтов из открытого файла.
 411+ 0000              ;    Все аргументы в регистрах:
 412+ 0000              ;        B - хэндл файла.
 413+ 0000              ;        DE - указатель на буфер, куда следует прочитать массив байтов.
 414+ 0000              ;        HL - количество байтов, которые следует прочитать.
 415+ 0000              ;    Возвращаемые значения в регистрах:
 416+ 0000              ;        А - ошибка. Если 0x00, то ошибки нет.
 417+ 0000              ;        HL - если ошибки нет, то содержит количество прочитанных байтов (если 0, то файл кончился).
 418+ 0000              ;
 419+ 0000              ;Пример чтения из открытого файла:
 420+ 0000              ;        ...
 421+ 0000              ;        LD A,(FILE)
 422+ 0000              ;        LD B,A
 423+ 0000              ;        LD DE,READ_BUF
 424+ 0000              ;        LD HL,150
 425+ 0000              ;        OS_READHANDLE
 426+ 0000              ;        OR A
 427+ 0000              ;        JP NZ,ERR_EXIT    ;обработка ошибок
 428+ 0000              ;        LD A,H
 429+ 0000              ;        OR L
 430+ 0000              ;        JP Z,END_READ    ;данных для чтения нет, либо указатель чтения\записи указывает на конец файла
 431+ 0000              ;        ...
 432+ 0000              ;READ_BUF
 433+ 0000              ;        DEFS 1000
 434+ 0000              ;Примечание: при чтении сдвигается (на количество прочитанных байт)
 435+ 0000              ;указатель на данные в файле, следующее чтение начнётся с позиции этого указателя.
 436+ 0000                      macro OS_READHANDLE ;B = file handle, DE = Buffer address, HL = Number of bytes to read, out: HL = Number of bytes actually read, A=error
 437+ 0000 ~                    ld c,CMD_READHANDLE
 438+ 0000 ~                    CALLBDOS_NOPARAM_A
 439+ 0000                      endm
 440+ 0000
 441+ 0000              ;*********************** OS_WRITEHANDLE **********************
 442+ 0000              ;Запись массива байтов в открытый файл.
 443+ 0000              ;    Все аргументы в регистрах:
 444+ 0000              ;        B - хэндл файла.
 445+ 0000              ;        DE - указатель на буфер, содержащий массив байтов, которые следует записать в файл
 446+ 0000              ;        HL - количество байтов, которые следует записать
 447+ 0000              ;    Возвращаемые значения в регистрах:
 448+ 0000              ;        А - ошибка. Если 0x00, то ошибки нет.
 449+ 0000              ;        HL - если ошибки нет, то содержит количество записанных байтов.
 450+ 0000              ;
 451+ 0000              ;Пример записи в открытый файл:
 452+ 0000              ;        ...
 453+ 0000              ;        LD A,(FILE)
 454+ 0000              ;        LD B,A
 455+ 0000              ;        LD DE,BUF
 456+ 0000              ;        LD HL,BUF_SIZE
 457+ 0000              ;        OS_WRITEHANDLE
 458+ 0000              ;        OR A
 459+ 0000              ;        JP NZ,ERR_EXIT    ;обработка ошибок
 460+ 0000              ;        ...
 461+ 0000              ;BUF        DEFB "Hello Work!"
 462+ 0000              ;BUF_SIZE EQU $-BUF
 463+ 0000              ;
 464+ 0000              ;Примечание: при записи сдвигается (на количество записанных байтов)
 465+ 0000              ;указатель на данные в файле, следующая запись начнётся с позиции этого указателя.
 466+ 0000                      macro OS_WRITEHANDLE ;B = file handle, DE = Buffer address, HL = Number of bytes to write, out: HL = Number of bytes actually written, A=error
 467+ 0000 ~                    ld c,CMD_WRITEHANDLE
 468+ 0000 ~                    CALLBDOS_NOPARAM_A
 469+ 0000                      endm
 470+ 0000
 471+ 0000              ;*********************** OS_SEEKHANDLE **********************
 472+ 0000              ;Перемещение указателя чтения/записи в файле.
 473+ 0000              ;    Все аргументы в регистрах:
 474+ 0000              ;        B - хэндл файла.
 475+ 0000              ;        DEHL - нужное смещение относительно начала файла.
 476+ 0000              ;    Возвращаемых значений нет.
 477+ 0000              ;
 478+ 0000              ;Примечание: в отличие от MSX-DOS, смещение всегда относительно начала файла (регистр A не влияет).
 479+ 0000              ;Для чтения положения указателя см. функцию OS_TELLHANDLE.
 480+ 0000              ;Для чтения размера файла см. функцию OS_GETFILESIZE.
 481+ 0000                      macro OS_SEEKHANDLE ;b=file handle, dehl=offset
 482+ 0000 ~                    ld c,CMD_SEEKHANDLE
 483+ 0000 ~                    CALLBDOS_NOPARAM_A
 484+ 0000                      endm
 485+ 0000
 486+ 0000              ;*********************** OS_CHDIR **********************
 487+ 0000              ;Сменить текущую директорию (в рамках текущего процесса).
 488+ 0000              ;    Все аргументы в регистрах:
 489+ 0000              ;        DE - указатель на строку с полным или относительным путём (можно без конечной косой черты).
 490+ 0000              ;    Возвращаемые значения в регистрах:
 491+ 0000              ;        А - ошибка. Если 0x00, то ошибки нет.
 492+ 0000              ;
 493+ 0000              ;Примечание: В отличие от MSX-DOS, в пути используются только прямые косые черты.
 494+ 0000              ;Например: "e:/bin/".
 495+ 0000                      macro OS_CHDIR ;DE = Pointer to ASCIIZ string. Out A=error
 496+ 0000 ~                    ld c,CMD_CHDIR
 497+ 0000 ~                    CALLBDOS_NOPARAM_A
 498+ 0000                      endm
 499+ 0000
 500+ 0000              ;*********************** OS_GETPATH **********************
 501+ 0000              ;Прочитать текущий путь (в рамках текущего процесса).
 502+ 0000              ;    Все аргументы в регистрах:
 503+ 0000              ;        DE - указатель на буфер размером MAXPATH_sz, куда будет помещён путь (ASCIIZ).
 504+ 0000              ;    Возвращаемые значения в регистрах:
 505+ 0000              ;        HL - указатель на последний элемент пути в этом буфере
 506+ 0000              ;
 507+ 0000              ;Примечания:
 508+ 0000              ;В MSX-DOS был буфер размером 64 байта, а в текущей реализации NedoOS MAXPATH_sz = 256.
 509+ 0000              ;Путь возвращается без конечной косой черты, кроме случая корня диска.
 510+ 0000              ;В отличие от MSX-DOS, в пути используются только прямые косые черты.
 511+ 0000                      macro OS_GETPATH ;DE = Pointer to MAXPATH_sz byte buffer ;out: DE = Filled in with whole path string (WITH DRIVE! Finished by slash only if root dir), HL = Pointer to start of last item
 512+ 0000 ~                    ld c,CMD_GETPATH
 513+ 0000 ~                    CALLBDOS_NOPARAM_A
 514+ 0000                      endm
 515+ 0000
 516+ 0000              ;*********************** OS_RENAME **********************
 517+ 0000              ;Переименовать файл или директорию.
 518+ 0000              ;    Все аргументы в регистрах:
 519+ 0000              ;        DE - старое имя, возможно с полным или относительным путём (ASCIIZ).
 520+ 0000              ;        HL - новое имя, пока что требуется такой же путь, как в DE.
 521+ 0000              ;    Возвращаемые значения в регистрах:
 522+ 0000              ;        HL - указатель на последний элемент пути в этом буфере
 523+ 0000              ;        A  - FRESULT error code (C unsigned char: only A; HL is not a return).
 524+ 0000              ;             0  = FR_OK (success)
 525+ 0000              ;             1  = FR_DISK_ERR
 526+ 0000              ;             2  = FR_INT_ERR
 527+ 0000              ;             3  = FR_NOT_READY
 528+ 0000              ;             4  = FR_NO_FILE      (old name missing)
 529+ 0000              ;             5  = FR_NO_PATH
 530+ 0000              ;             6  = FR_INVALID_NAME
 531+ 0000              ;             7  = FR_DENIED
 532+ 0000              ;             8  = FR_EXIST        (new name taken -- typical updater retry)
 533+ 0000              ;             9  = FR_INVALID_OBJECT
 534+ 0000              ;            10  = FR_WRITE_PROTECTED
 535+ 0000              ;            11  = FR_INVALID_DRIVE
 536+ 0000              ;            12  = FR_NOT_ENABLED
 537+ 0000              ;            13  = FR_NO_FILESYSTEM
 538+ 0000              ;            14..18 = FR_MKFS_ABORTED / FR_TIMEOUT / FR_LOCKED /
 539+ 0000              ;                     FR_NOT_ENOUGH_CORE / FR_TOO_MANY_OPEN_FILES
 540+ 0000              ;        Success: A=0. Not OS_GETPATH: HL is NOT a path pointer here.
 541+ 0000              ;        (Kernel FatFs leaves FRESULT in L; IAR wrapper: ld a,l, restore caller HL.)
 542+ 0000              ;Примечания:
 543+ 0000              ;В отличие от MSX-DOS, в новом имени пока что требуется такой же путь, как в DE (если там не было пути, то и в новом не надо).
 544+ 0000                      macro OS_RENAME ;DE = Drive/path/file ASCIIZ string, HL = New filename ASCIIZ string (NOT MSXDOS compatible! with Drive/path!) ;RENAME OR MOVE FILE
 545+ 0000 ~                    ld c,CMD_RENAME
 546+ 0000 ~                    CALLBDOS_NOPARAM_A
 547+ 0000                      endm
 548+ 0000
 549+ 0000              ;*********************** OS_DELETE **********************
 550+ 0000              ;Удалить файл.
 551+ 0000              ;    Все аргументы в регистрах:
 552+ 0000              ;        DE - имя файла, возможно с полным или относительным путём (ASCIIZ).
 553+ 0000              ;    Возвращаемые значения в регистрах:
 554+ 0000              ;        А - ошибка. Если 0x00, то ошибки нет.
 555+ 0000                      macro OS_DELETE ;DE = Drive/path/file ASCIIZ string, out: A = Error
 556+ 0000 ~                    ld c,CMD_DELETE
 557+ 0000 ~                    CALLBDOS_NOPARAM_A
 558+ 0000                      endm
 559+ 0000
 560+ 0000              ;*********************** OS_PARSEFNAME **********************
 561+ 0000              ;Перекодировать имя файла в формат CP/M (8 байт имени, 3 байта расширения).
 562+ 0000              ;    Все аргументы в регистрах:
 563+ 0000              ;        DE - имя файла в ASCIIZ.
 564+ 0000              ;        HL - указатель на буфер под имя файла в формате CP/M.
 565+ 0000              ;    Возвращаемые значения в регистрах:
 566+ 0000              ;        DE - указатель на терминатор имени файла
 567+ 0000              ;        HL - указатель на буфер под имя файла в формате CP/M.
 568+ 0000              ;        A - всегда 0.
 569+ 0000              ;
 570+ 0000              ;Примечание: в отличие от MSX-DOS, не возвращаются флаги результата в регистре B.
 571+ 0000                      macro OS_PARSEFNAME ;de(dotname) -> hl(cpmname) ;out: de=pointer to termination character, hl=buffer filled in
 572+ 0000 ~                    ld c,CMD_PARSEFNAME
 573+ 0000 ~                    CALLBDOS_NOPARAM_A
 574+ 0000                      endm
 575+ 0000
 576+ 0000              ;invented
 577+ 0000                      macro OS_SETTIME ;ix=date, hl=time
 578+ 0000 ~                    ld c,CMD_SETTIME
 579+ 0000 ~            	CALLBDOS_NOPARAM_A
 580+ 0000                      endm
