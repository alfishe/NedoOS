 596+ 0000                      endm
 597+ 0000                      macro OS_GETSTDINOUT ;e=stdin, d=stdout, h=stderr, l=hgt of stdout
 598+ 0000 ~                    ld c,CMD_GETSTDINOUT
 599+ 0000 ~            	CALLBDOS_NOPARAM_A
 600+ 0000                      endm
 601+ 0000
 602+ 0000              ;*********************** OS_PLAYCOVOX **********************
 603+ 0000              ;Синхронно проигрывает 8-битный PCM-сэмпл через Covox (порт 0xFB, ?Pentagon CovoxFB?).
 604+ 0000              ;Работает на ATM2 и Evo (и других конфигурациях с Covox на порту 0xFB). На ATM3 и PE26
 605+ 0000              ;аппаратного Covox нет ? вызов не приведёт к ошибке, но звука не будет.
 606+ 0000              ;Вызов блокирующий: управление возвращается только после окончания сэмпла.
 607+ 0000              ;На время проигрывания прерывания запрещены (DI), турбо-режим EGA временно выключается
 608+ 0000              ;(бит 3 в порту 0xBD77 сбрасывается) и восстанавливается по завершении.
 609+ 0000              ;    Все аргументы в регистрах:
 610+ 0000              ;        HL - адрес начала сэмпла в области 0xC000..0xFFFF (старший байт адреса >= 0xC0).
 611+ 0000              ;             Сэмпл ? последовательность байтов без знака, центрированных около 0x80
 612+ 0000              ;             (тишина = 0x80, амплитуда 0..255). Конец сэмпла отмечается байтом 0x00.
 613+ 0000              ;             ВАЖНО: 0x00 ? одновременно и ?тишина?, и маркер конца! Значение 0x00
 614+ 0000              ;             внутри сэмпла обрывает проигрывание. При подготовке данных нулевые отсчёты
 615+ 0000              ;             заменяют на 0x01 (см. утилиту evoresc, makesample.h).
 616+ 0000              ;        DE - указатель на таблицу страниц (pagetable) в основной странице процесса
 617+ 0000              ;             (адреса 0x0000+). Таблица ? массив номеров страниц ОЗУ, по одному байту
 618+ 0000              ;             на каждые 16 КБ данных сэмпла. Первый байт ? страница для области 0xC000,
 619+ 0000              ;             второй ? для следующих 16 КБ (после переполнения HL за 0xFFFF), и т.д.
 620+ 0000              ;             Номера страниц ? те же, что возвращает OS_NEWPAGE / OS_GETMAINPAGES
 621+ 0000              ;             (с учётом модели памяти ATM2/ATM3/Evo).
 622+ 0000              ;             Ядро отображает основную страницу процесса в 0x8000 и читает таблицу по
 623+ 0000              ;             адресу DE|0x8000 (устанавливает бит 7 регистра D).
 624+ 0000              ;        HX - задержка между отсчётами (чем меньше ? тем выше частота дискретизации).
 625+ 0000              ;             Типичные значения (реальная частота при 14 МГц):
 626+ 0000              ;                 HX=27  ~  8 кГц
 627+ 0000              ;                 HX=18  ~ 11 кГц  (11025 Гц в WAV)
 628+ 0000              ;                 HX=11  ~ 16 кГц
 629+ 0000              ;                 HX=7   ~ 22 кГц  (22050 Гц в WAV)
 630+ 0000              ;                 HX=3   ~ 33 кГц
 631+ 0000              ;                 HX=1   ~ 44 кГц  (44100 Гц в WAV)
 632+ 0000              ;    Возвращаемых значений нет.
 633+ 0000              ;    Портит все регистры.
 634+ 0000              ;
 635+ 0000              ;Формат каталога сэмплов (как в играх на evosdk, страница SND_PAGE):
 636+ 0000              ;    SMP_COUNT  ? байт: количество сэмплов (до 256).
 637+ 0000              ;    SMP_LIST   ? таблица 4?256 байт, для сэмпла с индексом N (0..SMP_COUNT-1):
 638+ 0000              ;        [SMP_LIST + N + 0]   ? младший байт смещения данных внутри страницы
 639+ 0000              ;        [SMP_LIST + N + 256] ? старший байт смещения (к адресу добавляется 0xC000)
 640+ 0000              ;        [SMP_LIST + N + 512] ? индекс первой страницы в pagetable (~номер_страницы)
 641+ 0000              ;        [SMP_LIST + N + 768] ? значение HX (задержка / частота)
 642+ 0000              ;    Pagetable (массив tpags[256] в основной странице) заполняется при загрузке ресурсов:
 643+ 0000              ;    tpags[i] = номер страницы ОЗУ, куда загружен i-й блок данных (page_N.bin).
 644+ 0000              ;    Для сэмпла, занимающего несколько страниц, в pagetable подряд идут номера
 645+ 0000              ;    последовательных страниц, начиная с индекса из SMP_LIST+512.
 646+ 0000              ;
 647+ 0000              ;Пример проигрывания сэмпла по номеру (упрощённо, из games/_sdk/lib_sound.asm):
 648+ 0000              ;        LD A,SND_PAGE          ;страница со звуковыми данными
 649+ 0000              ;        SETPGC000
 650+ 0000              ;        LD A,(SMP_COUNT|0xC000)
 651+ 0000              ;        LD E,A
 652+ 0000              ;        LD A,L                 ;L = номер сэмпла
 653+ 0000              ;        CP E
 654+ 0000              ;        JR NC,.skip
 655+ 0000              ;        LD H,HIGH(SMP_LIST|0xC000)
 656+ 0000              ;        LD E,(HL)              ;смещение, младший байт
 657+ 0000              ;        INC H
 658+ 0000              ;        LD A,(HL)              ;смещение, старший байт
 659+ 0000              ;        OR 0xC0
 660+ 0000              ;        LD D,A
 661+ 0000              ;        INC H
 662+ 0000              ;        LD A,(HL)              ;индекс в pagetable
 663+ 0000              ;        CPL
 664+ 0000              ;        INC H
 665+ 0000              ;        LD H,(HL)              ;H = задержка
 666+ 0000              ;        EX DE,HL               ;HL = адрес сэмпла, D = задержка
 667+ 0000              ;        LD HX,D                ;HX = задержка
 668+ 0000              ;        LD E,A                 ;E = индекс в pagetable
 669+ 0000              ;        LD D,TPAGES/256        ;D = старший байт адреса pagetable
 670+ 0000              ;        OS_PLAYCOVOX
 671+ 0000              ;.skip
 672+ 0000              ;
 673+ 0000              ;Подготовка WAV-файлов: утилита src/games/_sdk/tools_src/evoresc (ключ -samplelist).
 674+ 0000              ;Конвертирует моно/стерео PCM 8/16 бит в формат Covox, упаковывает в page_*.bin
 675+ 0000              ;и заполняет SMP_LIST / tpags. Готовый sound.bin подключается к проекту как SND_PAGE.
 676+ 0000              ;
 677+ 0000              ;Примечание: во время проигрывания не вызывайте YIELD и не полагайтесь на прерывания.
 678+ 0000              ;Для фонового звука используйте OS_SETMUSIC (PT3) или AY-эффекты; OS_PLAYCOVOX ? для
 679+ 0000              ;коротких синхронных сэмплов (выстрел, взрыв, щелчок и т.п.).
 680+ 0000                      macro OS_PLAYCOVOX ;hl=data (0xc000+, 0x00=end), de=pagetable (0x0000+), hx=delay
 681+ 0000 ~                    ld c,CMD_PLAYCOVOX
 682+ 0000 ~            	CALLBDOS_NOPARAM_A
 683+ 0000                      endm
 684+ 0000                      macro OS_SETMUSIC ;hl=muzaddr (0x4000..0xffff, 0=killmuz), a=muzpg (pages in 0x8000, 0xc000 are taken from current user memory)
 685+ 0000 ~                    ld c,CMD_SETMUSIC
 686+ 0000 ~            	CALLBDOS
 687+ 0000                      endm
 688+ 0000                      macro OS_READSECTORS ;b=drive, de=buffer, ixhl=sector number, a=count ;out: a=error
 689+ 0000 ~                    ld c,CMD_READSECTORS
 690+ 0000 ~            	CALLBDOS
 691+ 0000                      endm
