как адресовать память по ?s:de = (?s*16 + de)/16384 и mod 16384:
?s*16 сразу хранить как 24 бита (для всех ?s)
	macro memDS
	ld bc,(ds_LSW)
	add hl,bc
	ld a,(ds_HSW)
	adc a,0
	xor h
	and 0x3f
	xor h ;a = номер страницы (%01..5432)
	set 7,h
	set 6,h
	SETPGC000
	endm

	macro memES
	ld bc,(es_LSW)
	add hl,bc
	ld a,(es_HSW)
	adc a,0
	xor h
	and 0x3f
	xor h ;a = номер страницы (%01..5432)
	set 7,h
	set 6,h
	SETPGC000
	endm

	macro putmemDS
	push af
	memDS
	pop af
	ld (hl),a
	endm

	macro putmemES
	push af
	memES
	pop af
	ld (hl),a
	endm

	macro putmemspBC
        LD HL,(_SP)
	inc l
	dec l
	call z,recountsp
	dec l
	ld (hl),b
	call z,recountsp
	dec l
	ld (hl),c
        LD (_SP),HL	
	endm

	macro getmemspBC
        LD HL,(_SP)
	ld c,(hl)
        inc l
	call z,recountsp
	ld b,(hl)
        inc l
	call z,recountsp
        LD (_SP),HL
	endm

	macro inchlwithflags ;знак неправильный!!! FIXME (CY не должен меняться?)
	ex af,af'
	inc l
	jr nz,$+3
	inc h
	ex af,af'
	endm

	macro dehlwithflags ;знак неправильный!!! FIXME (CY не должен меняться?)
	ex af,af'
	dec l
	jr nz,$+3
	dec h
	ex af,af'
	endm

	macro cmphl
	ex af,af'
	sub (hl)
	exx
	ld d,a ;parity data
	rra
	ld e,a ;overflow data
	exx
	ex af,af'
	endm

	macro cmpc
	ex af,af'
	sub c
	exx
	ld d,a ;parity data
	rra
	ld e,a ;overflow data
	exx
	ex af,af'
	endm



