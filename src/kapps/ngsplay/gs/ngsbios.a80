        ld (Jr_sld4),a      
        ld a,c ;exa
        jp SampSlideDoun_in

SampSlideUp4x      
        ld c,a ;exa
        xor a
        ld (Jr_sld4),a      
        ld a,c ;exa
        jp SampSlideUp_in

SampSlideUp2x      
        ld c,a ;exa
        ld a,Jr_to2-Jr_sld4-1
        ld (Jr_sld4),a      
        ld a,c ;exa
        jp SampSlideUp_in

SampSlideUp
;************************************
;   a - �� ᪮�쪮� ��ਮ��� b,hl - ⥪�騩 ��ਮ�
;   b,hl - ���� ��ਮ�
;************************************
        ld c,a ;exa
        ld a,Jr_to4-Jr_sld4-1
        ld (Jr_sld4),a 
        ld a,c ;exa
SampSlideUp_in
        ex de,hl
        ld hl,codop
        res 3,(hl)
        ex de,hl
        jr SampDoun_up
SampSlideDoun
;************************************
;   a - �� ᪮�쪮� ��ਮ��� b,hl - ⥪�騩 ��ਮ�
;   b,hl - ���� ��ਮ�
;************************************
        ld c,a ;exa
        ld a,Jr_to4-Jr_sld4-1
        ld (Jr_sld4),a 
        ld a,c ;exa 
SampSlideDoun_in
        ex de,hl
        ld hl,codop
        set 3,(hl)
        ex de,hl
SampDoun_up        
        push bc,hl  ; �������� b,hl
        ; 37500 / 1712 (Ami C-4) = 21,90420561
        ; 8363*16/21,90420561=6108,781226
        ; * 6109 = % 1011111011101

        ld e,b
        ld d,0

        push de
        ld de,hl
        exx 
        pop hl
        ld de,hl

;**************************************************
;   ���� ��ਠ�� 㬭������ �� ᤢ����   ��� ᤢ��� - 16 ⠪⮢
;**************************************************
;         exx : sla e : rl d
;         exx : rl e : rl d

;         DUP 3
;         exx : sla e : rl d
;         exx : rl e : rl d
;         exx : add hl,de
;         exx : adc hl,de
;         EDUP
;         exx : sla e : rl d
;         exx : rl e : rl d
;         DUP 5
;         exx : sla e : rl d
;         exx : rl e : rl d
;         exx : add hl,de
;         exx : adc hl,de
;         EDUP
;         exx : sla e : rl d
;         exx : rl e : rl d
;         DUP 1
;         exx : sla e : rl d
;         exx : rl e : rl d
;         exx : add hl,de
;         exx : adc hl,de
;         EDUP


        ;1011111011101  - 6109
        ;hl=de=Period
;**************************************************
;   ��ன ��ਠ�� 㬭������ �� ᫮������  1 ᫮����� - 11 ⠪⮢
;   �� ��饥 ������� ����権 �� ��⠫, ������� �� �� �����
;**************************************************
        exx : add hl,hl ;= 1+1 = 2
        exx : adc hl,hl ;= 1+1 = 2
        exx : add hl,hl ;= 2+2 = 4
        exx : adc hl,hl ;= 2+2 = 4

        exx : ex hl,de
        add hl,de   ;= 4+1 = 5
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 4+1 = 5
        ex hl,de

        exx : add hl,hl ;= 4+4 = 8
        exx : adc hl,hl ;= 4+4 = 8

        exx : ex hl,de
        add hl,de   ;= 8+5 = 13
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 8+5 = 13
        ex hl,de

        exx : add hl,hl ;= 8+8
        exx : adc hl,hl ;= 8+8

        exx : ex hl,de
        add hl,de   ;= 16+13 = 29
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 16+13 = 29
        ex hl,de

        exx : add hl,hl ;= 16+16
        exx : adc hl,hl ;= 16+16
        exx : add hl,hl ;= 32+32 = 64
        exx : adc hl,hl ;= 32+32 = 64

        exx : ex hl,de
        add hl,de   ;= 64+29 = 93
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 64+29 = 93
        ex hl,de

        exx : add hl,hl ;= 64+64 = 128
        exx : adc hl,hl ;= 64+64 = 128

        exx : ex hl,de
        add hl,de   ;= 128+93 = 221
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 128+93 = 221
        ex hl,de

        exx : add hl,hl ;= 128+128 = 256
        exx : adc hl,hl ;= 128+128 = 256

        exx : ex hl,de
        add hl,de   ;= 256+221 = 477
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 256+221 = 477
        ex hl,de

        exx : add hl,hl ;= 256+256 = 512
        exx : adc hl,hl ;= 256+256 = 512

        exx : ex hl,de
        add hl,de   ;= 512+477 = 989
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 512+477 = 989
        ex hl,de

        exx : add hl,hl ;= 512+512 = 1024 
        exx : adc hl,hl ;= 512+512 = 1024
     
        exx : ex hl,de
        add hl,de   ;= 1024+989 = 2013
        ex hl,de
        exx : ex hl,de
        adc hl,de   ;= 1024+989 = 2013
        ex hl,de

        exx : add hl,hl ;= 1024+1024
        exx : adc hl,hl ;= 1024+1024
        exx : add hl,hl ;= 2048+2048 
        exx : adc hl,hl ;= 2048+2048 
        exx : add hl,de ;= 4096+2013 = 6109
        exx : adc hl,de ;= 4096+2013 = 6109
;**************************************************
       
        ld (PerSpd1),hl
        exx
        ld (PerSpd2),hl

        pop hl,bc

SaveSpd219
        ld d,b,e,h,c,l
        srl d : rr e : rr c
        srl d : rr e : rr c

        jr Jr_to4 ; ������� ��� �� 4 �� EEx FEx
Jr_sld4 equ $-1
        srl d : rr e : rr c
Jr_to2  srl d : rr e : rr c
Jr_to4
        ld h,0 : ld l,h
        DUP 7
        rr a
        jr nc,1F
        add hl,de
1       sla c : rl e : rl d  ; Period * A
        EDUP
        rr a
        jr nc,1F
        add hl,de
1
        ld bc,hl
        ld hl,ConstSpg  ;(ix+smp.CSpdKns)
        sub hl,bc   ; Cspd219+Peiod*x
codop   equ $-1     ; ADC - set 3 , SBC res 3
        jr nc,1F
        ld hl,13 ; 26 ; ��������� ����� ��ਮ� - �।����⮫筮
1       push hl
        ld hl,0
PerSpd1 equ $-2
        ld de,0
        exx
        ld hl,0
PerSpd2 equ $-2
        pop de

        call ldiv ;hl'hl = hl'hl / de'de
        exx
        push hl
        exx
        pop bc
        ld b,c

