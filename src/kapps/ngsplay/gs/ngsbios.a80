;         DUP 32*60
;         db 0
;         db 0    ; �஬����� L ������ , ���⠭��� � ��⮬ �����㬥�⮢ �� �஬���� � �䥪⮢
;         db 0    ; �஬����� R ������ , ���⠭��� � ��⮬ �����㬥�⮢ �� �஬���� � �䥪⮢
;         dw 0    ; ��砫쭠� ��࠭�� � ���� sampl
;         dw 0    ; ��࠭�� ��ࢮ�� ���� ��� ⥪�饩 ����樨 0 - ����� ��⠭����� 
;         dw 0    ; �஡��� ���� ⥪�饩 ����樨
;         dw 0    ; 楫�� ���� ⥪�饩 ����樨
;         dw 0    ; �஡��� ���� ��ਮ�� ���饭��
;         dw 0    ; 楫�� ���� ��ਮ�� ���饭��
;         dw 0    ; ��࠭�� ��ࢮ�� ����  ��砫� ��o��  0 - ���� ��⠭�����
;         dw 0    ; 楫�� ���� ��砫� �����
;         dw 0    ; ��࠭�� ��ࢮ�� ���� ������       
;         dw 0  a  ; 楫�� ���� - ������ � ����� ����
;         db 0    ; ChnVol - �஬����� ������
;         db 0    ; ChnPan - ������ ������    ��� 7 - �몫�祭
;         dw 0    ; ��ࠡ��稪 ��䥪⮢ ��� ������� ⨪�
        ;EDUP

COMZ    OUT (CLRCBIT),A
        JP COMINT_

; AC=C*�    call  MulCB    ; AC=C*�                       
MulCB   XOR A                           
        DUP 8                           
        RR C                            
        JR NC,$+3                       
        ADD B                         
        RRA                             
        EDUP                             
        RR C 
        ret
     

;�LD�=D�*�C call  MulDEBC ;�LD�=D�*�C
MulDEBC
        LD HL,0                         
        DUP 16                          
        RR D,E                          
        JR NC,$+3                       
        ADD HL,BC                      
        RR H,L                          
        EDUP                            
        RR D,E   
        ret

;D�=D�/�C, �L=���⮪ CALL DIVU222 ;D�=D�/�C
DIVU222 LD HL,0                         
        DUP 16                          
        RL E,D                          
        ADC HL,HL                       
        SBC HL,BC                       
        JR NC,$+3                       
        ADD HL,BC                       
        EDUP                             
        LD A,E                          
        RLA                             
        CPL                             
        LD E,A                          
        LD A,D                          
        RLA                             
        CPL                             
        LD D,A  
        ret

; ����� �� 2006-12-18T15:11:28+0300
; ����������� 32-ࠧ�來�� �������
; �㭪�� ��⮨� �� ���� ��⥩:
; 1. 32-ࠧ�來�� ������� � 16-ࠧ�來�
; ����⥫�.
; 2. 32-ࠧ�來�� ������� � 32-ࠧ�來�
; ����⥫�.
; hl'hl = hl'hl / de'de
; de'de = hl'hl % de'de
ldiv    ; call ldiv ;hl'hl = hl'hl / de'de
        push hl 
        xor a 
        ld l, a
        ld h, a 
        sub e 
        ld e, a
        ld a, h
        sbc a, d
        ld d, a
        exx 
        pop bc 
        ld a, 0
        sbc a, e
        ld e, a
        sbc a, d ; de'de=0-divisor
        sub e
        ld d, a 
        and e
        inc a ; Z=short divisor
        push hl 
        ld hl, 0 ; hl'hl=reminder
        exx 
        pop bc 
        ld a, b ; a,c,bc'=divident

        jp nz, ldiv_long

        ; divisor = -00de
;        ld b, 8
        rla 

;ldivs0
        DUP 8
        rl l 
        add hl, de 
        jr c, 1F ; ldivs1
        sbc hl, de 
;ldivs1  
1       rla 
;        djnz ldivs0
        EDUP

        ld b, c
        ld c, a
        ld a, b 
;        ld b, 8
        rla
;ldivs2
        DUP 8
        adc hl, hl
        add hl, de
        jr c, 1F ;ldivs3
        sbc hl, de
;ldivs3  
1        rla
        ;djnz ldivs2
        EDUP
        jr ldiv_long1

        ; divisor=-de'de
ldiv_long
        call ldiv_8
        ld b, c
        ld c, a
        ld a, b
        call ldiv_8
ldiv_long1
        exx 

;         exa 
;         ld a, b
;         exa
;         ld b, a
;         exa
        ld iyl,b
        ld b,a
        ld a,iyl

        exx 
        call ldiv_8
        exx
;         exa
;         ld a, c
;         exa
;         ld c, a
;         exa
        ld iyl,c
        ld c,a
        ld a,iyl

        exx 
        call ldiv_8

        ; result=c,bc',a -> hl'hl 
        ; reminder=hl'hl -> de'de 

        ex de, hl 
        ld l, a 
        ld a, c 
        exx
        ex de, hl 
        ld h, a
        ld l, b
        ld a, c 
        exx 
        ld h, a
        ret 

        ; hl'hl=reminder
        ; de'de=divisor
        ; a=divident
ldiv_8
;        ld b, 8
        rla 
        DUP 8
;ldiv_8_0
        adc hl, hl
        exx
        adc hl, hl 
        exx
        add hl, de 
        exx 
        adc hl, de 
        exx 
        jr c, 1F ;ldiv_8_1
        sbc hl, de 
        exx
        sbc hl, de
        exx 
;ldiv_8_1
1        rla 
        ;djnz ldiv_8_0
        EDUP
        ret 


