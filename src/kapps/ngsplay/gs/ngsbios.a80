        jr z,no_sample
        jr 3F

2       ld (ix+smp.LastSmp),a
3       dec a   ; ����� �࠭���� �� 1, � 0 � 255 - �।��騩 �����㬥��
no_sample
        ld d,a 
        ld hl,(SAMPLADR)
        ld a,l ;(SAMPLADR) ; ������砥� ��࠭��� � ����������� ������
        SetPg_macr
        ld a,h
        ld l,0
        ld h,d  ; ����� �����
        srl h : rr l
        set 7,h 
        add h
        ld h,a
        ld a,b
        cp 255 ;and a
        jp z,no_note
        cp 254 ;and a
        jp nz,No_off_note
NulSmp  xor a
        ld (ix+smp.CurPage),a    ; ⥪ ��࠭��  - 0 ��⠭���� ������
        ld (NewCurAdr),a
        jp no_note       
No_off_note
        ld (ix+smp.Nota),a
        res 0,(ix+smp.FlgEFF)        
;   ���樠������ �����
        and #0F ; ����砥� ����
        add a,a : add a,a
        add a,#050 ; ���� ��ਮ��� ��� � � ��������� �����
        or l 
        ld e,(hl)   ; ������ ���ન �� � �����ᢨ� ����
        dec e       ;
        jr nz,NulSmp ;
        push hl     ; �������� ��砫�� ���� #00 ��������� �����
        ld l,a

        ld e,(hl)   ; ����砥� ��ਮ� ��� ���� �।��� ��⠢�
        inc l
        ld d,(hl)
        inc l
        ld l,(hl)

        ld a,#6F;#9F    ; �� ���⠭�� �� ���� �������� ����� ��⠢� � ���襬 ���㡠��
        sub b
        jr c,_rolUp
        rrca : rrca : rrca :rrca ; ����� ��⠢� � ���襬 ���㡠��
        and #0F
        jr z,_rolDn
        ld b,a
32      srl l : rr d : rr e  ; ����� ����� �� ����� ��⠢�
        djnz 32B
        jr _rolDn
_rolUp  neg
        rrca : rrca : rrca :rrca ; ����� ��⠢� � ���襬 ���㡠��
        and #03
        inc a
        ld b,a
32      sla e : rl d : rl l  ; 㬭����� ����� �� ����� ��⠢�
        djnz 32B
_rolDn
        ;ld (ix+smp.PerFrac),de       ; 24 ���� ��ਮ�
        ld (NewFrac),de ; �।���⥫쭮 ��࠭塞 ���� ��ਮ� �
        ;ld (ix+smp.PerFrac+2),l
        ld h,0
        ld (NewInt),hl

        pop iy ; ��������� �����

;         ld a,(iy+#4F)
;         cp "S"
;         jr nz,NulSmp

        ld hl,(iy+s3m.Int_Gp)
        ld (NewCurAdr),hl   ; �।���⥫쭮 ��࠭塞 ���� ���� �����,
                            ; ⠪ ��� ��� ����� ���� ������� ᯥ���䥪⠬�
;
        ; ������塞 ������ � ����
        bit 0,(iy+s3m.SmpFlags)
        jr z,_no_loop
        ; ���� 横�. �����뢠�� ��砫� 横��
        ; ����� 横�� �����뢠�� � ������
        ld hl,(iy+s3m.LoopEndInPg)
        ld (NewLength),hl
        ;ld (ix+smp.Length),hl

        ld a,(iy+s3m.PgLoopEnd)
        ld (NewPgLeng),a
        ;ld (ix+smp.PgLeng),a    ; ��࠭�� ������

        ld hl,(iy+s3m.LoopBegInPg)
