        ;ld (ix+smp.LoopSt),hl

        ld a,(iy+s3m.PgLoopBeg)
        ld (NewPgLoop),a
        ;ld (ix+smp.PgLoop),a    ; ��࠭�� ��砫� �㯠
        jr _y_loop
_no_loop ; ��� 横��
        ld hl,(iy+s3m.LengthInPg)
        ld (NewLength),hl
        ;ld (ix+smp.Length),hl

        ld a,(iy+s3m.PgLength)
        ld (NewPgLeng),a
        ;ld (ix+smp.PgLeng),a    ; ��࠭�� ������
        xor a
        ld (NewPgLoop),a
        ;ld (ix+smp.PgLoop),0    ; noloop

_y_loop
        ; ���쬥� �஬���� �����㬥�� � ����� � ����襬 � �����, ��⮬ ���६ �᫨ ����
        ld a,(iy+s3m.Vol)
        or a
        jr z,64F
        dec a
64      ld (ix+smp.ChnVol),a
        ld a,(iy+s3m.GVl)
        ;dec a
        ld (ix+smp.SmplVol),a

no_note
        ; �����頥� ����
;        ld hl,(PATERNADR)
        ld a,(PATERNADR) ;l

        SetPg_macr

        POP HL
        ld a,(hl)  ; 64-0  �஬����� ��� ��������� + 128 255 - ����
        inc hl
        cp 255
        jr z,_mulVol
        BIT 7,a
        jr z,_VolSet
        ; ��� ����� ����� �㤥� ���������

        jr _InPanSet
_VolSet or a
        jr z,64F
        dec a
64      ld (ix+smp.ChnVol),a
        jr _ChngVol
_InPanSet

_mulVol ld a,(NewInt+1)
        inc a
        jr z,_nochngvol
_ChngVol 
        ld a,(GlVol) ; 0-128 => 0-64
        srl a
        ld e,(ix+smp.ChnVol)
        MulAE ; A 0-64 E 0-63
        ld e,a
        ld a,(ix+smp.SmplVol)
        MulAE ; A 0-64 E 0-63
        ld e,a
        ld a,(ix+smp.GlChVol)
        MulAE ; A 0-64 E 0-63

        ;ld a,63; ��� �⫠��� ���� �஬�����
        ld (ix+smp.Vol_L),a
        ld (ix+smp.Vol_R),a ; ���� ��� �������樨 � ������ 䨪�஢��� - ��襬 �஬����� � ���
        ld (ix+smp.SaveVL),a
        ld (ix+smp.SaveVL+1),a

_nochngvol
        ; ���� ᯥ���䥪⮢
        ld a,(hl)
        inc hl
        and a
        ex de,hl
        jr z,NoEff
        dec a ; ⠡ �� 0

        ld hl,0
TabEff  equ $-2
        and 31
        rlca
        add l
        ld l,a
        ld a,(hl)
        inc l
        ld h,(hl)
        ld l,a
        ld a,(de)
        jp (hl)
NoEff   ld hl,_RowNoEff
YepEff  res 2,(ix+smp.FlgEFF)
YepEffQ ld (ix+smp.EffJmp),hl
        bit 0,(ix+smp.FlgEFF)
        jr z,1F
        res 0,(ix+smp.FlgEFF)
        ld hl,(ix+smp.SaveFrc)
        ld (ix+smp.PerFrac),hl
        ld a,(ix+smp.SaveFrc+2)
        ld (ix+smp.PerInt),a
1
        call RefNewSmp  ; ������� ���� ����� ����� � ⥪�騩 �����

        bit 1,(ix+smp.FlgEFF)
        jr z,2F
        ld hl,(ix+smp.SaveVL)
        ld (ix+smp.Vol_L),hl ; �ࠧ� ��� ������ � ���
        res 1,(ix+smp.FlgEFF)   ; �� ����⠭��������
2
        ex de,hl        
        inc hl

_nextLopChn
        ld bc,smp.lenHead
        add ix,bc
        pop bc
        dec b
        jp nz,_lopChrInRow
ret1ch  nop
        ld a,(ROWSCUR)
        cp 63
ROWSINPAT equ $-1        
        jr nc,_endpat
        inc a
        ld (ROWSCUR),a

        ld bc,(LENROWS)
        ld hl,(ROWSADR)
        add hl,bc
        ; ��� ��� �஢���� ���᪮� ��࠭���� � �������� ����� ���ୠ
        bit 6,h
        jr z,1F
        res 6,h
        ld a,(PATERNADR)
        inc a
        ld (PATERNADR),a
1        
        ld (ROWSADR),hl
        ret
RefNewSmp        
        ld hl,0
NewInt  equ $-2
        inc h   ; 255 - ���� ����
        ret z
        ld (ix+smp.PerInt),l
        ld a,255        ;ld h,255
        ld (NewInt+1),a ;ld (NewInt),hl

        ld hl,0
NewFrac equ $-2
        ld (ix+smp.PerFrac),hl

        ld hl,0
NewCurAdr equ $-2
        ; ld (ix+smp.SamplAdr),hl ; ����������� ��� DMA
        ld (ix+smp.CurPage),l
        ld (ix+smp.CurAdr),0    ;ld l,0
        ld (ix+smp.CurAdr+1),h  ;ld (ix+smp.CurAdr),hl

        ld hl,0
NewLength equ $-2
        ld (ix+smp.Length),hl
        ;ld a,0
        ld (ix+smp.PgLeng),#FF ;a    ; ��࠭�� ������
NewPgLeng equ $-1
        ld hl,0
NewLoopSt equ $-2
        ld (ix+smp.LoopSt),hl
        ;ld a,0
        ld (ix+smp.PgLoop),#FF ;a    ; ��࠭�� ��砫� �㯠
NewPgLoop equ $-1

        ;ld hl,0
        ;ld (ix+smp.CurFrac),hl
        ld (ix+smp.CurFrac),0
        ld (ix+smp.CurFrac+1),0
;        ld (ix+smp.CurAdr),hl
_oldsmp ret


_chnoff ld (ix+smp.CurPage),0
        inc hl : inc hl : inc hl : inc hl : inc hl
        jp _nextLopChn

_endpat

        ld a,(PATERN)
        ld a,1
        call SETPAGE2
        ld b,3 ; ᪮�� ࠧ �� ���� �窠�� ����
        ; ᫥���騩 �थ�
_lpord  ld hl,(ORDER)
looppat inc l
        ld a,(hl)
4       cp 255
        jr nz,2555F
        ld de,calcrov_z
        ld (To_cl_row),de
        ld l,0
        ld a,(hl)
        djnz 2555F
        jr 1F
;   �����稫�� ����� - ���� � - 0 ����� - �� ��२��樠���������� 
;   ��砫�뭥 ᪮����, �ମ����� � �
calcrov_z ; �����誠 ����⠢����� ����� calk_row � ���� �����
        ld hl,calk_row
        ld (To_cl_row),hl

        ld a,1
        call SETPAGE2
        ld a,(FlagPlay)
        bit 1,a ; No repeat
        jr z,58F
        di
        xor a
        ld (PROCESS),a
         jp COME4
58      bit 0,a
        ld a,(CurModul)
        ;jr z,56F
        jp z,calk_row
        inc a
        ld hl,KolModule
        cp (hl)
        jr c,56F
        xor a
56      di  
        ld sp,ISTACK
        ld h,a
        xor a
        jp startmodul ; � H ����� ����� � A ����� ����樨

2555    cp 254
        jr nz,3f
        inc l
        ld a,(hl)
        jr 4B
3       ld (ORDER),HL

        ld (PATERN),A
        LD L,A
        INC H   ; ⠡��� ����⥫�� ���୮�
        LD e,(hl)
        inc h
        ld d,(hl)
        inc h
        ld a,(hl)
        ld (ROWSINPAT),A
        or a
        jp z,_lpord        
1
        ld l,0
EfaRowN equ $-1
        dec a
        cp l ; �஢��塞 �� ����� �� ������ �⨬ ��룭���
        ld a,l
        jr nc,_OkRow
        xor a ; ������, ������ �� 0 ��ப�
        ld (EfaRow),a
        ld (EfaRow+1),a
_OkRow  ld (ROWSCUR),a
        ;ld (Last_Row),a
        ld (PATERNADR),DE
        ld e,0
        ld hl,00
EfaRow  equ $-2      
        add hl,de   ; ���᪮� �� ��ப�
        ; ��� ��� �஢���� ���᪮� ��࠭� � �������� ����� ���ୠ
        bit 6,h
        jr z,1F
        res 6,h
        ld a,(PATERNADR)
        inc a
        ld (PATERNADR),a
1 
        ld (ROWSADR),hl
        xor a
        ld l,a,h,a
        ld (EfaRow),hl
        ld (EfaRowN),a
        ld a,255
        ld (nxtDTZX),a        
        ret



calk_tikeff
        ld ix,SamplTabl
        ld a,(CHNPAT)
        ld b,a
EffLop  push bc
        bit 7,(ix+smp.GlChVol)
        jp nz,_RowNoEff
        ld hl,(ix+smp.EffJmp)
        ;ld h,(ix+smp.EffJmp+1)
        jp (hl)
_RowNoEff
        ld bc,smp.lenHead
        add ix,bc
        pop bc
        djnz EffLop
_RET    ret

