DataToZX
        IN A,(ZXSTAT)
        ;RLA
        ;RET C   ; ���� ����� ��� �� ��⠫�
        AND 0X81
        RET NZ ; ���� ����� ��� �� ��⠫�
        ld a,255   ; 0 - 255 ᨭ�஭����� 1-nummod 2-numord 3-numrow
nxtDTZX equ $-1
        inc a
        and 3
        ld (nxtDTZX),a
        jr nz,1F
        ld a,255
        OUT (ZXDATWR),A
        ret
1       dec a
        jr nz,2F
        ld a,(MODULE)
        OUT (ZXDATWR),A
        ret
2       dec a
        jr nz,3F
        ld a,(ORDER)
        OUT (ZXDATWR),A
        ret
3       dec a
        jr nz,4F
        ld a,(ROWSCUR)
        OUT (ZXDATWR),A
        ret
4       ret

