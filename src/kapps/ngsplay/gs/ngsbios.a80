

_BIOS   ; 
        PHASE   #0000
        module BIOS   
        di
        jp initngs
NUMPG   db  0
LoopPat db  0
        align 32
OfsChenal   dw  0  ; 2 ����, �� ������ ������ �����
        nop
        align 16
        nop
        align 8
INT8    
        exa ;push af
        PUSH hl      
        ld h,#60
Faza    equ $-1    
        ld l,a            
        LD A,(hl) 
        INC h
        LD A,(hl)
        INC h
        LD A,(hl) 
        INC h
        LD A,(hl)
        INC h
        LD A,(hl)
        INC h
        LD A,(hl)
        INC h
        LD A,(hl)
        INC h
        LD A,(hl)
        INC l
        JR Z,INT8_
        LD A,l
        ;ld (AF_sv),a
        POP hl
        exa ;pop af
        EI
        RET  
INT8_   
        LD A,h
        INC A
        OR #60
        AND #78

        ld (Faza),a ;ld h,a
        LD A,l ;ld (AF_sv),HL
        POP hl
        exa ;pop af
        EI
        RET                

        align 256
initngs 
        LD SP,ISTACK
        in a,(GSCFG0)
        and #FF-M_CKSEL0-M_CKSEL1-M_PAN4CH-M_RAMRO
        OR C_12MHZ+M_EXPAG+M_8CHANS
        OUT (GSCFG0),a
        OUT (CLRCBIT),A
INIT_   XOR A
        OUT (ZXDATWR),A
        OUT (VOL1),A
        OUT (VOL2),A
        OUT (VOL3),A
        OUT (VOL4),A
        OUT (VOL5),A
        OUT (VOL6),A
        OUT (VOL7),A
        OUT (VOL8),A

        in a,(GSCFG0)
        and #FF-M_CKSEL0-M_CKSEL1-M_PAN4CH-M_RAMRO
        OR C_24MHZ+M_EXPAG+M_8CHANS
        OUT (GSCFG0),a

        LD HL,0X8000
        LD A,0X7F
        OUT (MPAG),A
        LD (HL),0XAA
        LD A,0X3F
        OUT (MPAG),A
        LD (HL),0X55
        LD A,0X7F
        OUT (MPAG),A
        LD A,(HL)
        CP 0XAA
        LD A,0X7E                       ;���������� ������� ��� 4 ����������� NEOGS
        ld hl,#4000
        JR Z,CP_RAMPAGES
        LD A,0X3E                       ;���������� ������� ��� 2 ����������� NEOGS
        ld hl,#4000
CP_RAMPAGES LD (NUMPG),A
        ld (Mem.MaxAdr),hl
        ;OUT (ZXDATWR),A
        ld a,1
        call SETPAGE2
        ld hl,"TN"
        ld (#BC00),hl
        ld hl,#0102
        ld (#BC02),hl

        ld hl,#FF00
        ld (KolModule),hl
        ld hl,#0100
        ld (LastAdr),hl
        ld hl,#004
        ld (LastPage),hl
        LD a,(NUMPG)        
        ld (AllPage),a
;         xor a     ; �뭥ᥭ� � ���
;         set 0,a ; �� 㬮�砭�� ०�� ��������
;         set 2,a ; �� 㬮�砭�� ०�� ����㧪� ����� � ZX
;         ld (FlagPlay),a
        ld hl,#6000
        ld de,#6001
        ld bc,#1fff
        ld (hl),#80
        ldir

        ld hl,SamplTabl
        ld de,SamplTabl+1
        ld bc,#0fff-64
        ld (hl),0
        ldir

        ld hl,Tab64
        ld de,Tab64+1
        ld bc,63
        ld (hl),0
        ldir

        ld hl,Tab64-1+65*64
        ld bc,#4040

mullop  push bc
        dec b
        call  MulCB    ; AC=C*�
        rl c : rla
        rl c : rla
        rl c
        adc 0
        ld (hl),a
        dec hl
        pop bc
        djnz mullop
        ld b,#40
        dec c
        jr nz,mullop
        jr COMINT ; COMHZ

        MODULE Mem
GetMem 
;       ��ᯥ��� ����� NGS , �뤫便� ������ ��������� ࠧ��� � ������ �� 256 ����
;       �室 hl - �ॡ㥬�� ������ ����� � ᥣ����� �� 256 ����
;       ��室 H-ᬥ饭�� � ��砫� ��࠭��� L-����� ��࠭���
;            de - ���� ����㭭�� ����� � ᥣ����� �� 256 ���� - ��� DMA
        ld de,(LastAdr)
        push de
        add hl,de
        ld de,(MaxAdr)
        sub hl,de
        jr nc,_noGSMem
        add hl,de
        ld (LastAdr),hl
        ld de,(LastPage)
        push de

        ld a,l
        and #03F
        ld (LastSeg),a
        ld a,h
        sla l : rla
        sla l : rla
        ld (LastPage),a
        pop hl
        pop de
        ret
_noGSMem       
        jp BIOS._ErrorMem

MaxAdr    dw      #4000 ; #2000 ��� 2 �� ���ᨩ (256/4 - � ॠ� ����)
LastPage  db      4
LastSeg   db      0
LastAdr   dw      #100
        ENDMODULE


COMHZ   xor a
        OUT (CLRCBIT),A
COMINT  LD SP,ISTACK
COMINT_ IN A,(ZXSTAT)
        RRCA
        JR C,COMINT1
        JP COMINT_

COMINT1 IN A,(ZXCMD)
        CP 0X20
        JR C,COMLOW
COMINT2 CP 0XE0
        JR C,COMINT_
        SUB 0XC0
COMLOW  ADD A,A
        LD H,HIGH COMTAB
        or LOW COMTAB
        LD L,A
        LD A,(HL)
        INC L
        LD H,(HL)
        LD L,A
        JP (HL)

;Jamp to Address (*)
;��।��� �ࠢ����� �� ��������� �����.
COM13   IN A,(ZXDATRD)
        OUT (CLRCBIT),A
        LD L,A
        LD IY,COM13_1
        JP WTDTL

COM13_1 LD H,A
        JP (HL)

COMF5 ; new module
        IN A,(ZXDATRD)
        ld b,a
        ld a,1
        SetPg_macr
        jp New.Create

COMF6   ; load sample
        IN A,(ZXDATRD)
        OUT (CLRCBIT),A
        dec a
        ld (SMPin),a
        LD IY,COMF6_1
        JP WTDTL
COMF6_1
        ld (inModul),a

        ld a,1
        call SETPAGE2
        ld a,2
        call SETPAGE3

        ld bc,#0100
        ld de,LoadBufer
        CALL COM14_JPLOAD
        ld hl,(BIOS.LoadBufer)
        ld bc,"IR"
        sub hl,bc
        jp nz,_noswaw
        ld hl,(BIOS.LoadBufer+8)
        ld bc,"AW"
        sub hl,bc
        jp nz,_noswaw

        ld hl,(EndBIOS)
        ld de,"wa"
        sub hl,de 
        call nz,OverLDwav 

        CALL LoadSMP.load_header
        JP COMINT_  

OverLDwav
        ld a,2
        call SETPAGE3
        ld de,EndBIOS
        ld hl,LoadSMP.wavload
        ld bc,LoadSMP.Endwavload-LoadSMP.wavload
        ldir
        ret

_noswaw
; ᫥���騩 ��� �����
        jp NoMiModul

SMPin   db 0
inModul db 0
        
COME8  
        IN A,(ZXDATRD)
        OUT (CLRCBIT),A
        ld (LoadModul),a

        ld a,1
        call SETPAGE2
        ld a,2
        call SETPAGE3

        ld bc,#0100
        ld de,LoadBufer
        CALL COM14_JPLOAD

; �஢�ઠ ⨯� �����
        ld hl,(BIOS.LoadBufer+#2c)
        ld bc,"CS"
        sub hl,bc
        jp nz,_nos3m
        ld hl,(BIOS.LoadBufer+#2e)
        ld bc,"MR"
        sub hl,bc
        jp nz,_nos3m
        jp Load_s3m
_nos3m  
; ᫥���騩 ��� �����
        jp NoMiModul
Ret_Load
        ld a,0
LoadModul equ $-1
        ld (Load.Modul),a

        ld h,a
        ld l,0
        LD a,#80
        add h
        add h
        add h
        add h
        add h
        ld h,a      ; � HL ���� ��������� �����
        ld (Load.Head),hl
        xor a
        ld (Load.BitSmp),a
        ld (sign1),a
        ld (sign2),a
        ld (sign3),a

        ld (Load.ChenSmp),a

        CALL Load.load_header
        ld bc,0
        ld (OfsChenal),bc
        JP COMINT_  
Load_s3m
        ld hl,(EndBIOS)
        ld de,"s3"
        sub hl,de 
        call nz,OverLDs3m 
        jp Ret_Load
OverLDs3m
        ld a,2
        call SETPAGE3
        ld de,EndBIOS
        ld hl,Load.s3mload
        ld bc,Load.Ends3mload-Load.s3mload
        ldir
        ret

; ��������� ��� �����
_ErrorMem ld a,123
        jr 123F
NoMiModul
        ld a,255
123
        ld hl,0
        ld (Load.NextLen),hl
        ld (Load.NextOfs),hl
        ld (Load.NextBlock),a
        ld (Load.LastBlock),a
        jp BIOS.COMINT

COME9 
        xor a
        ld (Load.BitSmp),a
        ld (Load.ChenSmp),a
        ld (sign1),a
        ld (sign2),a
        ld (sign3),a
        
        ld a,(Load.LastBlock)
        cp 1
        jp z,Load.LoadHead
        cp 2
        jp z,Load.SmpLoadHead
        cp 4
        jp z,Load.SpmLoad
        cp 6
        jp z,Load.PatHead
        cp 7
        jp z,Load.PatLoad
returnCOME9
        ld a,(Load.NextBlock) 
        ld (Load.LastBlock),a
returnCOME9end
        OUT (ZXDATWR),A
        OUT (CLRCBIT),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Load.NextOfs)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Load.NextOfs+1)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Load.NextLen)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Load.NextLen+1)
        OUT (ZXDATWR),A 

        JP COMINT_  

COMEA   
; 3. #EA ����㧨�� ���ॡ������ ����
; A ᪮�쪮 ������ �� 256 ���� ��।���  (�� ����� �40 - 16�� )
    
        IN A,(ZXDATRD)
        OUT (CLRCBIT),A
        ld c,a
        ld a,(Load.NextPage)
        SetPg_macr
        ld a,(Load.SkipByte)
        or a
        jr z,31F
        ld b,a
1       IN A,(ZXSTAT) ; �ய�᪠�� ���㦭� ����� � ����
        AND #81
        JR Z,1B
        IN A,(ZXDATRD)
        JP P,COMINT1 
        djnz 1B       
31
        ld b,c
        ld a,(Load.SkipByte)
        ld (Load.LastSkipByte),a
        ld c,a
        xor a
        sub c
        ld c,a
        jr nc,1F
        dec b ; ����⠫� ������ �� ���⮬ �ய�饭��� ����
1
        ld de,(Load.NextAdr)
        ld a,(Load.BitSmp)
        or a
        jr z,1F
        CALL COM14_JP16bit
        jr 2F
1       CALL COM14_JPLOAD
2       bit 6,d
        jr z,nopcgpg
        res 6,d
        ld a,(Load.NextPage)
        inc a
        ld (Load.NextPage),a
nopcgpg ld (Load.NextAdr),de        
        xor a
        ld (Load.SkipByte),a
        JP COMINT_  

COMF0   
;   F0 ����� ��࠭���� �����
        IN A,(ZXDATRD)
        ld (SaveModul),a

        ld h,a
        ld L,0
        LD a,#80
        add a,h
        add a,h
        add a,h
        add a,h
        add a,h
        ld h,a 
        ld ix,hl
        ld a,1
        call BIOS.SETPAGE2        
;   �஢�ઠ ⨯� �����
        ld hl,(ix+#2c)
        ld bc,"CS"
        sub hl,bc
        jp nz,_nossv
        ld hl,(ix+#2e)
        ld bc,"MR"
        sub hl,bc
        jp nz,_nossv

        jp Save_s3m
_nossv  
        ld a,255
        OUT (ZXDATWR),A         
        OUT (CLRCBIT),A
        JP COMINT_ 
Ret_Save
        xor a
        OUT (ZXDATWR),A         
        OUT (CLRCBIT),A
        JP COMINT_  

Save_s3m
        ld hl,(EndBIOS)
        ld de,"3S"
        sub hl,de 
        call nz,OverSVs3m 
        ld a,(SaveModul)
        call Save.Faza0
        jp Ret_Save

SaveModul db 0
FazaSave db 0
OverSVs3m
        ld a,2
        call SETPAGE3
        ld de,EndBIOS
        ld hl,Save.s3mSave
        ld bc,Save.Ends3mSave-Save.s3mSave
        ldir
        ret

COMF1   
;   F1 ���㧨�� ���ॡ������ ����
        ld a,(FazaSave)
        ld (oldfz),a
        call FazaDec ; � DE, �� �㤠 ���㦠��
        ld a,0
oldfz   equ $-1
        or a
        jr z,end_fzsv
        OUT (ZXDATWR),A         
        OUT (CLRCBIT),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Save.FatOfs)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Save.FatOfs+1)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Save.FatOfs+2)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Save.FatOfs+3)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3

        ld a,(Save.FatLen)
        OUT (ZXDATWR),A
        CPL
        LD C,A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(Save.FatLen+1)
        OUT (ZXDATWR),A
        CPL
        LD B,A
        INC BC
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        JP COM15IN 

end_fzsv
        OUT (ZXDATWR),A         
        OUT (CLRCBIT),A        
        JP COMINT_  
FazaDec
        dec a
        jp z,Save.Faza1
        dec a
        jp z,Save.Faza2
        dec a
        jp z,Save.Faza3
        dec a
        jp z,Save.Faza4
        dec a
        jp z,Save.Faza5
        dec a
        jp z,Save.Faza6
        ret

COMEB   ; 㤠���� ����� �� �����
        IN A,(ZXDATRD)
        call DeleteModul
        ld a,(KolModule) 
        OUT (ZXDATWR),A
        OUT (CLRCBIT),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(LastAdr)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(LastAdr+1)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(LastPage)
        OUT (ZXDATWR),A
        IN A,(ZXSTAT)
        RLA : JR C,$-3
        ld a,(LastPage+1)
        OUT (ZXDATWR),A 
        JP COMINT_ 

DeleteModul
        push af
        ld a,1
        call SETPAGE2
        pop af
        or a
        jr z,_dellast
        cp 255
        jr z,_dellall
        ret
_dellast 
        ld a,(KolModule)
        or a
        jr z,_dellall
        dec a
        jr z,_dellall
        ld (KolModule),a
        ;inc a

        add a
        add a
        add a
        add a
        add #10
        ld l,a
        ld h,#BC
        ld e,(hl)
        inc hl
        ld d,(hl)
        inc hl
        ld (LastAdr),de
        ld e,(hl)
        inc hl
        ld d,(hl)
        ld (LastPage),de
        ret
_dellall
        ld hl,#FF00
        ld (KolModule),hl
        ld hl,#0100
        ld (LastAdr),hl
        ld hl,#004
        ld (LastPage),hl
        ret


;Load memory block (*)
;����㧪� ����� ����� �� 㪠������� ����� � �������� ������.
; 70+27*WAIT PER LOOP : 171K,123K,96K PER SECOND MAX
COM14   IN A,(ZXDATRD)
        OUT (CLRCBIT),A
        CPL
        LD C,A
        LD HL,WTDTL
        LD IY,COM14_1
        JP (HL)

COM14_1 CPL
        LD B,A
        INC BC
        LD IY,COM14_2
        JP (HL)

COM14_2 LD E,A
        LD IY,COM14_3
        JP (HL)
        
COM14_3 LD D,A
        LD A,B
        OR C
        JP Z,COMINT_
        CALL COM14_JP
        JP COMINT_  
COM14_JPLOAD
        ld a,c
        cpl
        ld c,a
        ld a,b
        cpl 
        ld b,a
        inc bc

COM14_JP        
        LD IXL,B
        LD B,0X81
        BIT 0,C
        JR NZ,COM14_7

COM14_6 IN A,(ZXSTAT)
        AND B
        JR Z,COM14_6
        IN A,(ZXDATRD)
        JP P,COMINT_1
        add 0
sign2   equ $-1
        LD (DE),A
        INC DE
        INC C
COM14_7 IN A,(ZXSTAT)
        AND B
        JR Z,COM14_7
        IN A,(ZXDATRD)
        JP P,COMINT_1
        add 0
sign3   equ $-1
        LD (DE),A
        INC DE
        INC C
        JP NZ,COM14_6
        INC IXL
        JP NZ,COM14_6
        RET
COMINT_1 pop hl
        jp COMINT1        

COM14_JP16bit
        ld a,c
        cpl
        ld c,a
        ld a,b
        cpl 
        ld b,a
        inc bc

COM14_JP16        
        LD IXL,B
        LD B,0X81
        BIT 0,C
        JR NZ,COM14_716

COM14_616 IN A,(ZXSTAT)
        AND B
        JR Z,COM14_616
        IN A,(ZXDATRD)
        JP P,COMINT_1
        ;LD (DE),A
        ;INC DE
        INC C
COM14_716 IN A,(ZXSTAT)
        AND B
        JR Z,COM14_716
        IN A,(ZXDATRD)
        JP P,COMINT_1
        add 0
sign1   equ $-1
        LD (DE),A
        INC DE
        INC C
        JP NZ,COM14_616
        INC IXL
        JP NZ,COM14_616
        RET


;Get memory block (*)
;���㧪� ����� ����� �� 㪠������� ����� � �������� ������.
COM15   IN A,(ZXDATRD)  ;�訡��-�� ���뢠���� ������ ���
        CPL
        LD C,A
        LD IY,COM15_1
        JP WTDTG
        
COM15_1 CPL
        LD B,A
        INC BC
        LD IY,COM15_2
        JP WTDTG
        
COM15_2 LD E,A
        LD IY,COM15_3
        JP WTDTG
        
COM15_3 LD D,A
COM15IN LD A,B
        OR C
        JP Z,COMINT_
        LD IXL,B
        LD B,0X81
        LD A,(DE)
        INC DE
        OUT (ZXDATWR),A
        OUT (CLRCBIT),A
        LD HL,COM15_4
        INC C
        JP NZ,COM15_4
        INC IXL
        JP Z,COMINT_
COM15_4 IN A,(ZXSTAT)
        AND B
        JR Z,COM15_5
        JP P,COMINT1
        IN A,(ZXSTAT)
        AND B
        JR Z,COM15_5
        JP P,COMINT1
        IN A,(ZXSTAT)
        AND B
        JR Z,COM15_5
        JP P,COMINT1
        IN A,(ZXSTAT)
        AND B
        JR Z,COM15_5
        JP P,COMINT1
        JP (HL)

COM15_5 LD A,(DE)
        OUT (ZXDATWR),A
        INC DE
        INC C
        JP NZ,COM15_4
COM15_7 INC IXL
        JP NZ,COM15_4
        JP COMINT_

;Poke to address (*)
;�����뢠�� ������� ���� �� 㪠������� �����.
COM16   IN A,(ZXDATRD)
        OUT (CLRCBIT),A
        LD B,A
        LD IY,COM16_1
        JP WTDTL
        
COM16_1 LD L,A
        LD IY,COM16_2
        JP WTDTL
        
COM16_2 LD H,A
        LD (HL),B
        JP COMINT_

;Peek from long address (*)
;���뢠�� ������� ���� �� 㪠������� �������� ����
COMEF   ;DI
        IN A,(ZXDATRD) 
;        OUT (CLRCBIT),A
        LD C,A
        LD IY,COMEF_1
        JP WTDTG 
COMEF_1 LD L,A
        LD IY,COMEF_2
        JP WTDTG 
COMEF_2 
        LD H,A
        ld a,c

        sla h : rl a 
        sla h : rl a 
        call SETPAGE2

        srl h
        scf
        rr h
        LD A,(HL)
        OUT (ZXDATWR),A
        OUT (CLRCBIT),A

        ld a,(PROCESS)
        or a
        JP z,COMINT_
        ld a,255
        ld (nxtDTZX),a
        ;EI
        JP Continue


;Peek from address (*)
;���뢠�� ������� ���� �� 㪠������� ����.
COM17   IN A,(ZXDATRD)
        LD L,A
        LD IY,COM17_1
        JP WTDTL
        
COM17_1 LD H,A
        LD A,(HL)
        OUT (ZXDATWR),A
        OUT (CLRCBIT),A
        JP COMINT_


WTDTL   IN A,(ZXSTAT)
        AND 0X81
        JR Z,WTDTL
        IN A,(ZXDATRD)
        JP P,COMINT1
        JP (IY)
WTDTG   IN A,(ZXSTAT)
        OR A
        JP P,WTDTG
        IN A,(ZXDATRD)
        JP (IY)    

;Reset flags
;����뢠�� 䫠�� Data bit � Command bit.
COM00   IN A,(ZXDATRD)
        OUT (CLRCBIT),A
        JP COMINT_

;Set silence (*)
;�뢮��� � ���� ��� ������� 0X80. �� ��� ��⠭�������� �設�.
COM01   OUT (CLRCBIT),A
        LD A,0X80
        LD HL,DAC0
        LD (HL),A
        LD B,(HL)
        INC H
        LD (HL),A
        LD B,(HL)
        INC H
        LD (HL),A
        LD B,(HL)
        INC H
        LD (HL),A
        LD B,(HL)
        JP COMINT_

;Set low volume (*)
;��⠭�������� �஬����x ����� ��� ������� � ����.
COM02   OUT (CLRCBIT),A
        XOR A           ; LD A,0X3F �� ����⭮, ��祬� ��९�⠭� ���⠬� ������� 02 � 03
        OUT (VOL1),A
        OUT (VOL2),A
        OUT (VOL3),A
        OUT (VOL4),A
        OUT (VOL5),A
        OUT (VOL6),A
        OUT (VOL7),A
        OUT (VOL8),A
        JP COMINT_
