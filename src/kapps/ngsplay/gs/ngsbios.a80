_lopChrInRow 
        push bc

        bit 7,(ix+smp.GlChVol)
        jp nz,_chnoff
        ld b,(hl)   ; ���
        inc hl
        ld a,(hl)   ; �����㬥��
        inc hl
        PUSH HL

        or a    ;cp 255
        jr nz,2F
        ld a,(ix+smp.LastSmp)
