        call calk_row   ; ������� ����� ��ப� ���ୠ
To_cl_row equ $-2        
_looprows
        IN A,(ZXSTAT)
        RRCA
        JR NC,1F
        IN A,(ZXCMD)
        CP #0E4
        JP z,COME4
        CP #0E6
        JP z,COME6
        CP #0EF
        JP z,COMEF
        CP #0F2
        JP z,COMF2
1
Continue
        call Sample.sample     ; ������� � ���� ⠬ �� 横� ᨭ�஭���樨 � ��������
