;       ������ ��ப� ���ୠ,
;       ���������� ⠡���� �����஢����
;

last_PATERNADR db 0
last_ROWSADR   dw 0
Last_Pat       db 0
Last_Row       db 0 
calk_row  
;        ld hl,(PATERNADR)
        ld a,(PATERN)
        ld (Last_Pat),A

        ld a,(ROWSCUR)
        ld (Last_Row),A
 
