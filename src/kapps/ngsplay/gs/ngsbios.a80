;
;   ��ࠡ��稪� ᯥ� ��䥪⮢. �� 2 ��� s3m � IT ०���, �� ����� ᮢ������
;   
;
;
;***********************************************************************

lastFrac dw 0,0     ; ������������ ��᫥���� ��ਮ� ��� ���⠬��� 

EffAxx  ; ��⠭����� ᪮���� XX  - 100% ��� S3M �� 1 �� 31, � ⥬� �� 32 �� 255
        CP #20
        jp nc,ITTxA
        ld (SPED),a
        ld (SPEDTIC),a
        jp NoEff

ITAxx  ; ��⠭����� ᪮���� XX  - 100% ��� IT 0-255
        ld (SPED),a
        ld (SPEDTIC),a
        jp NoEff

ITTxx   ; Txx   ������ ⥬� xx (Set tempo to xx)
        or a
        jr nz,1F
        ld a,(ix+smp.LastEfT)
        jr 2F
1       ld (ix+smp.LastEfT),a
2    
        CP #20
        jr c,TSlid
ITTxA   ld (TEMP),a
        ld h,HIGH BPMTAB
        sla a
        ld l,a
        ld a,0
        adc h
        ld h,a
        ld a,(hl)
        inc l
        ld h,(hl)
        ld l,a
        ld (BPMBYTE),hl
        ld (BPMCUR),hl
        jp NoEff

TSlid   bit 4,a
        jr nz,TSlid_Up
        ld (ix+smp.Argum1),a
        ld hl,ITT0x
        jp YepEff

TSlid_Up and #0F
        ld (ix+smp.Argum1),a
        ld hl,ITT1x
        jp YepEff

ITT0x   ;T0x   ������� 㬥��襭�� ⥬�� (Tempo slide down) 
        ld a,(TEMP)
        sub (ix+smp.Argum1)
        CP #20   
        jr nc,_T20
        ld a,#20
_T20    ld (TEMP),a
        ld h,HIGH BPMTAB
        sla a
        ld l,a
        ld a,0
        adc h
        ld h,a
        ld a,(hl)
        inc l
        ld h,(hl)
        ld l,a
        ld (BPMBYTE),hl
        ld (BPMCUR),hl
        jp _RowNoEff

ITT1x   ;T1x   ������� 㢥��祭�� ⥬�� (Tempo slide up)
        ld a,(TEMP)
        add (ix+smp.Argum1)
        jr nc,_TFF
        ld a,#FF
_TFF 
        jp _T20

ITBxx  ; ��ࢠ�� ����, ��३� �� Order XX  - 100%
EffBxx ; � ␀���������������� �।�⠢����� 0-ff
        ld h,a ;exa
        ld a,1
        call SETPAGE2
        ld a,(FlagPlay)
        and 3 
        jr z,3F
        ld a,(PATERNADR)
        call SETPAGE2
        jp NoEff

3       ld a,h ;exa
        dec A
        ld (ORDER),a
        ld a,(ROWSCUR) 
        ld (ROWSINPAT),a
        ld a,(PATERNADR)    ;l
        SetPg_macr
        jp NoEff

EffCxx  ; ��ࢠ�� ��⥭�, � ᫥��饬 ��३� �� ��ப� XX  - 100%
        ; � �����筮� �।�⠢����� 0-99, �� �� FF ����� ���� �� 166-��
        and a
        jr nz,EffC01
        ld a,(ROWSCUR) 
        ld (ROWSINPAT),a
        jp NoEff
EffC01  push de
        ld c,a
        and #F0
        ld e,a  ; �ਤ���� ��ॢ����� #99 � #FF ��� S3M  ��� ����ॢ����� ��� IT
        ld a,c
        and #0F
        srl e 
        add e 
        srl e 
        srl e 
        add e
        ld (EfaRowN),a
        ld e,a
        ld a,(ROWSCUR) 
        ld (ROWSINPAT),a
        ld bc,(LENROWS)
        ld d,0
        call MulDEBC
        ld (EfaRow),de
        pop de
        jp NoEff

ITCxx   ; ��ࢠ�� ��⥭�, � ᫥��饬 ��३� �� ��ப� XX  - 100%
        ; � ␀���������������� �।�⠢����� 
        and a
        jr nz,ITC01
        ld a,(ROWSCUR) 
        ld (ROWSINPAT),a
        jp NoEff
ITC01   push de
        ld (EfaRowN),a
        ld e,a
        ld a,(ROWSCUR) 
        ld (ROWSINPAT),a
        ld bc,(LENROWS)
        ld d,0
        call MulDEBC
        ld (EfaRow),de
        pop de
        jp NoEff


EffDxx  ; �嬥����� �஬���� ����� � ������  D0x , Dx0 , DxF , DFx
        call EffDxx_sp
        jp YepEff

EffDxx_sp
        or a
        jr nz,1F
        ld a,(ix+smp.LastEfD)
        jr 2F
1       ld (ix+smp.LastEfD),a
2       ld l,a
        and #F0
        jp z,_dounVol
        cp #F0
        jr z,EffDFx
        ld a,l
        and #0F
        jp z,_upVol
        cp #0F
        jr z,EffDxF
        ld hl,_RowNoEff
        ret        

EffDxF  ld a,l
        and #F0
        rrca : rrca : rrca : rrca
        add (ix+smp.ChnVol)
        cp 64
        jp c,1F
        ld a,63
        jp 1F

EffDFx  ld a,l
        and #0F
        ld l,a
        ld a,(ix+smp.ChnVol)
        sub l
        jr nc,1F
        xor a
1       ld (ix+smp.ChnVol),a 
        ld l,a
        ld a,(GlVol) ; 0-128 => 0-64
        srl a
        ;ld l,(ix+smp.ChnVol)
        MulAL ; A 0-64 E 0-63
        ld l,a
        ld a,(ix+smp.SmplVol)
        MulAL ; A 0-64 E 0-63
        ld l,a
        ld a,(ix+smp.GlChVol)
        MulAL ; A 0-64 E 0-63

; 3        ; ��� ���� 㬭����� �� ����ࠬ�
        ld (ix+smp.Vol_L),A
        ld (ix+smp.Vol_R),A 
        ld hl,_RowNoEff
        ret

_dounVol
        ld a,l
        and #0F
        ld (ix+smp.Argum4),a
        ld hl,EffD0x
        ret
_upVol
        ld a,l
        and #F0
        rrca : rrca : rrca : rrca
        ld (ix+smp.Argum4),a
        ld hl,EffDx0
        ret

EffDx0  call EffDx0_
        jp _RowNoEff

EffDx0_ ld a,(ix+smp.ChnVol)
        add (ix+smp.Argum4)
        cp 64
        jp c,1F
        ld a,63
        jp 1F

EffD0x  call EffD0x_
        jp _RowNoEff

EffD0x_ ld a,(ix+smp.ChnVol)
        sub (ix+smp.Argum4)
        jr nc,1F
        xor a
1       ld (ix+smp.ChnVol),a        
        ld e,a

        ld a,(GlVol) ; 0-128 => 0-64
        srl a
        ;ld e,(ix+smp.ChnVol)
        MulAE ; A 0-64 E 0-63
        ld e,a
        ld a,(ix+smp.SmplVol)
