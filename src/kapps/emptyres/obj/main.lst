    127            C_task main(void)
    128            {
    129                    os_initstdio();
    130            
    131                    /* Bank init can take a while (OS_NEWPAGE, fill @ C000). Do it before any
    132                     * printf ? otherwise cmd redraws "M:/path>" on the idle line and the next
    133                     * print appends to that prompt. */
    134                    er_init_banks();
    135            
    136                    printf("emptyres: bank window toolkit demo\r\n");
    137                    printf("main @ 0100-BFFF, bank @ C000\r\n\r\n");
    138            
    139                    demo_data_bank();
    140                    printf("\r\n");
    141                    demo_resident_bank();
    142                    printf("\r\n");
    143                    demo_nested_map();
    144                    
    145                    if (g_dataPg != 0u)
    146                            bank_os_release_page(g_dataPg);
    147                    exit(0);
    148            }

