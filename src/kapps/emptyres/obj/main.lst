     50            void er_init_banks(void)
     51            {
     52                    main_pg.l = OS_GETMAINPAGES();
     53                    residentPg = main_pg.pgs.window_3;
     54                    bank_slot_set(ER_BANK_SLOT_RESIDENT, residentPg);
     55            
     56                    g_dataPg = 0u;
     57                    if (bank_os_new_page(&g_dataPg))
     58                    {
     59                            bank_slot_set(ER_BANK_SLOT_DATA, g_dataPg);
     60                            bank_data_poke_u32(g_dataPg, ER_DATA_SIG_OFF, ER_DATA_SIG_MAGIC);
     61                            bank_data_poke_u32(g_dataPg, ER_DATA_COUNTER_OFF, 1ul);
     62                            bank_data_poke_u8(g_dataPg, ER_DATA_PAYLOAD_OFF, 0xBEu);
     63                    }
     64            }
     65            
     66            static void demo_data_bank(void)
     67            {
     68                    unsigned long sig;
     69                    unsigned char payload;
     70                    unsigned char map_now;
     71            
     72                    printf("--- data bank (page %u @ C000) ---\r\n", (unsigned int)g_dataPg);
     73                    if (g_dataPg == 0u)
     74                    {
     75                            printf("  OS_NEWPAGE failed\r\n");
     76                            return;
     77                    }
     78            
     79                    sig = bank_data_peek_u32(g_dataPg, ER_DATA_SIG_OFF);
     80                    payload = bank_data_peek_u8(g_dataPg, ER_DATA_PAYLOAD_OFF);
     81                    printf("  sig=0x%lX payload=0x%02X\r\n", sig, payload);
     82            
     83                    bank_data_poke_u8(g_dataPg, ER_DATA_PAYLOAD_OFF, 0xEFu);
     84                    payload = bank_data_peek_u8(g_dataPg, ER_DATA_PAYLOAD_OFF);
     85                    printf("  after poke payload=0x%02X\r\n", payload);
     86            
     87                    map_now = bank_window_current();
     88                    printf("  C000 maps page %u (resident=%u data=%u)\r\n",
     89                               (unsigned int)map_now, (unsigned int)residentPg, (unsigned int)g_dataPg);
     90            }
     91            
     92            static void demo_resident_bank(void)
     93            {
     94                    unsigned short magic;
     95                    unsigned char tag;
     96                    unsigned char out;
     97                    char msg[48];
     98            
     99                    printf("--- resident bank (page %u @ C000) ---\r\n", (unsigned int)residentPg);
    100            
    101                    magic = ui_mock_magic();
    102                    printf("  r_mock_magic()=0x%04X (expect 0x%04X)\r\n", magic, ER_R_MOCK_MAGIC);
    103            
    104                    tag = 0x42u;
    105                    out = ui_mock_transform(tag);
    106                    printf("  r_mock_transform(0x%02X)=0x%02X (expect 0x%02X)\r\n", tag, out, (unsigned char)(tag ^ 0xA5u));
    107            
    108                    ui_mock_message(msg, (unsigned char)sizeof(msg), "hello");
    109                    printf("  r_mock_message: %s\r\n", msg);
    110            }
    111            
    112            static void demo_nested_map(void)
    113            {
    114                    unsigned char saved;
    115                    unsigned long sig;
    116            
    117                    printf("--- nested map: resident -> data ---\r\n");
    118                    saved = bank_push_slot(ER_BANK_SLOT_RESIDENT);
    119                    (void)ui_mock_magic();
    120                    sig = bank_data_peek_u32(g_dataPg, ER_DATA_SIG_OFF);
    121                    printf("  read data sig while resident mapped: 0x%lX\r\n", sig);
    122                    bank_pop(saved);
    123                    sig = bank_data_peek_u32(g_dataPg, ER_DATA_SIG_OFF);
    124                    printf("  read data sig after restore: 0x%lX\r\n", sig);
    125            }
