      8            unsigned char bank_window_current(void)
      9            {
     10                    union APP_PAGES cur;
     11            
     12                    cur.l = OS_GETMAINPAGES();
     13                    return cur.pgs.window_3;
     14            }
     15            
     16            void bank_window_map(unsigned char page)
     17            {
     18                    SETPG32KHIGH(page);
     19            }
     20            
     21            unsigned char bank_os_new_page(unsigned char *page_out)
     22            {
     23                    unsigned int pg;
     24            
     25                    pg = OS_NEWPAGE();
     26                    if (pg > 255u)
     27                            return 0u;
     28                    *page_out = (unsigned char)pg;
     29                    return 1u;
     30            }
     31            
     32            void bank_os_release_page(unsigned char page)
     33            {
     34                    if (page != 0u)
     35                            OS_DELPAGE(page);
     36            }
     37            
     38            unsigned char bank_push(unsigned char page)
     39            {
     40                    unsigned char saved;
     41            
     42                    saved = bank_window_current();
     43                    bank_window_map(page);
     44                    return saved;
     45            }
     46            
     47            void bank_pop(unsigned char saved)
     48            {
     49                    bank_window_map(saved);
     50            }
     51            
     52            unsigned char bank_push_stack(unsigned char page)
     53            {
     54                    unsigned char saved;
     55            
     56                    saved = bank_window_current();
     57                    if (g_bank_sp < BANK_STACK_MAX)
     58                            g_bank_stack[g_bank_sp++] = saved;
     59                    bank_window_map(page);
     60                    return saved;
     61            }
     62            
     63            void bank_pop_stack(void)
     64            {
     65                    unsigned char saved;
     66            
     67                    if (g_bank_sp == 0u)
     68                            return;
     69                    saved = g_bank_stack[--g_bank_sp];
     70                    bank_window_map(saved);
     71            }
     72            
     73            void bank_slot_set(unsigned char slot, unsigned char page)
     74            {
     75                    if (slot < BANK_SLOT_COUNT)
     76                            g_bank_slots[slot] = page;
     77            }
     78            
     79            unsigned char bank_slot_get(unsigned char slot)
     80            {
     81                    if (slot >= BANK_SLOT_COUNT)
     82                            return 0u;
     83                    return g_bank_slots[slot];
     84            }
     85            
     86            unsigned char bank_push_slot(unsigned char slot)
     87            {
     88                    return bank_push(bank_slot_get(slot));
     89            }
