     23            void r_mock_message(char *buf, unsigned char buf_sz, const char *prefix)
     24            {
     25                    unsigned char i;
     26                    unsigned char j;
     27            
     28                    if (buf == NULL || buf_sz == 0u)
     29                            return;
     30            
     31                    i = 0;
     32                    if (prefix != NULL)
     33                    {
     34                            while (prefix[i] != 0 && i + 1u < buf_sz)
     35                            {
     36                                    buf[i] = prefix[i];
     37                                    i++;
     38                            }
     39                    }
     40                    j = 0;
     41                    while (" [resident@C000]"[j] != 0 && i + 1u < buf_sz)
     42                    {
     43                            buf[i] = " [resident@C000]"[j];
     44                            i++;
     45                            j++;
     46                    }
     47                    buf[i] = 0;
     48            }

