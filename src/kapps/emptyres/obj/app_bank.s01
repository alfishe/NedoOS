	NAME	app_bank(16)
	RSEG	CODE(0)
	RSEG	UDATA0(0)
	EXTERN	OS_DELPAGE
	EXTERN	OS_GETMAINPAGES
	EXTERN	OS_NEWPAGE
	EXTERN	SETPG32KHIGH
	PUBLIC	bank_data_fill
	PUBLIC	bank_data_peek_u32
	PUBLIC	bank_data_peek_u8
	PUBLIC	bank_data_poke_u32
	PUBLIC	bank_data_poke_u8
	PUBLIC	bank_os_new_page
	PUBLIC	bank_os_release_page
	PUBLIC	bank_pop
	PUBLIC	bank_pop_stack
	PUBLIC	bank_push
	PUBLIC	bank_push_slot
	PUBLIC	bank_push_stack
	PUBLIC	bank_slot_get
	PUBLIC	bank_slot_set
	PUBLIC	bank_window_current
	PUBLIC	bank_window_map
	EXTERN	?CLZ80L_4_06_L00
	RSEG	CODE
bank_window_current:
	PUSH	BC
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	AF
	PUSH	AF
	PUSH	AF
	PUSH	AF
	CALL	OS_GETMAINPAGES
	LD	(IX-8),L
	LD	(IX-7),H
	LD	(IX-6),C
	LD	(IX-5),B
	LD	A,(IX-8)
	LD	SP,IX
	POP	IX
	POP	BC
	RET
bank_window_map:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	SETPG32KHIGH
	LD	SP,IX
	POP	IX
	RET
bank_os_new_page:
	PUSH	BC
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	OS_NEWPAGE
	PUSH	HL
	POP	IY
	LD	C,L
	LD	B,H
	LD	HL,255
	AND	A
	SBC	HL,BC
	JR	NC,?0011
?0010:
	XOR	A
	JR	?0012
?0011:
	PUSH	IY
	POP	HL
	PUSH	IY
	LD	L,(IX-2)
	LD	H,(IX-1)
	POP	BC
	LD	(HL),C
	LD	A,1
?0012:
	LD	SP,IX
	POP	IX
	POP	IY
	POP	BC
	RET
bank_os_release_page:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	INC	E
	DEC	E
	JR	Z,?0014
?0013:
	LD	E,(IX-2)
	CALL	OS_DELPAGE
?0014:
	LD	SP,IX
	POP	IX
	RET
bank_push:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	bank_window_current
	LD	D,A
	PUSH	DE
	CALL	bank_window_map
	POP	DE
	LD	A,D
	LD	SP,IX
	POP	IX
	RET
bank_pop:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	bank_window_map
	LD	SP,IX
	POP	IX
	RET
bank_push_stack:
	PUSH	BC
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	bank_window_current
	LD	D,A
	LD	A,(g_bank_sp)
	CP	4
	JR	NC,?0016
?0015:
	LD	HL,g_bank_sp
	LD	C,(HL)
	INC	(HL)
	LD	B,0
	LD	HL,g_bank_stack
	ADD	HL,BC
	LD	(HL),D
?0016:
	PUSH	DE
	LD	E,(IX-2)
	CALL	bank_window_map
	POP	DE
	LD	A,D
	LD	SP,IX
	POP	IX
	POP	BC
	RET
bank_pop_stack:
	PUSH	BC
	PUSH	DE
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	A,(g_bank_sp)
	OR	A
	JR	Z,?0019
?0017:
?0018:
	LD	HL,g_bank_sp
	DEC	(HL)
	LD	C,(HL)
	LD	B,0
	LD	HL,g_bank_stack
	ADD	HL,BC
	LD	B,(HL)
	LD	E,B
	PUSH	DE
	LD	E,B
	CALL	bank_window_map
	POP	DE
?0019:
	LD	SP,IX
	POP	IX
	POP	DE
	POP	BC
	RET
bank_slot_set:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	LD	D,E
	LD	A,E
	CP	4
	JR	NC,?0021
?0020:
	LD	C,D
	LD	B,0
	LD	HL,g_bank_slots
	ADD	HL,BC
	LD	B,(IX-2)
	LD	(HL),B
?0021:
	LD	SP,IX
	POP	IX
	RET
bank_slot_get:
	PUSH	BC
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	LD	A,E
	CP	4
	JR	C,?0023
?0022:
	XOR	A
	JR	?0024
?0023:
	LD	C,(IX-2)
	LD	B,0
	LD	HL,g_bank_slots
	ADD	HL,BC
	LD	A,(HL)
?0024:
	LD	SP,IX
	POP	IX
	POP	BC
	RET
bank_push_slot:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	D,E
	CALL	bank_slot_get
	LD	E,A
	CALL	bank_push
	LD	SP,IX
	POP	IX
	RET
bank_data_poke_u8:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	CALL	bank_push
	LD	(IX-6),A
	LD	A,192
	ADD	A,B
	LD	B,A
	LD	L,C
	LD	H,B
	LD	B,(IX+4)
	LD	(HL),B
	LD	E,(IX-6)
	CALL	bank_pop
	LD	SP,IX
	POP	IX
	RET
bank_data_peek_u8:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	CALL	bank_push
	LD	(IX-5),A
	LD	A,192
	ADD	A,B
	LD	B,A
	LD	A,(BC)
	LD	(IX-6),A
	LD	E,(IX-5)
	CALL	bank_pop
	LD	A,(IX-6)
	LD	SP,IX
	POP	IX
	RET
bank_data_poke_u32:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	CALL	bank_push
	LD	(IX-6),A
	LD	A,192
	ADD	A,B
	LD	B,A
	LD	L,C
	LD	H,B
	LD	C,(IX+6)
	LD	B,(IX+7)
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	(HL),C
	INC	HL
	LD	(HL),B
	LD	E,(IX-6)
	CALL	bank_pop
	LD	SP,IX
	POP	IX
	RET
bank_data_peek_u32:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	PUSH	AF
	PUSH	AF
	CALL	bank_push
	LD	(IX-10),A
	LD	A,192
	ADD	A,B
	LD	B,A
	LD	L,C
	LD	H,B
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	EX	DE,HL
	LD	(IX-8),L
	LD	(IX-7),H
	LD	(IX-6),C
	LD	(IX-5),B
	LD	E,(IX-10)
	CALL	bank_pop
	LD	C,(IX-6)
	LD	B,(IX-5)
	LD	L,(IX-8)
	LD	H,(IX-7)
	LD	SP,IX
	POP	IX
	RET
bank_data_fill:
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	CALL	bank_push
	LD	(IX-6),A
	LD	IY,0
?0026:
	LD	BC,16384
	PUSH	IY
	POP	HL
	AND	A
	SBC	HL,BC
	JR	NC,?0025
?0027:
	PUSH	IY
	POP	HL
	LD	A,192
	ADD	A,H
	LD	H,A
	LD	B,(IX-2)
	LD	(HL),B
	INC	IY
	JR	?0026
?0025:
	LD	E,(IX-6)
	CALL	bank_pop
	LD	SP,IX
	POP	IX
	POP	IY
	RET
	RSEG	UDATA0
g_bank_slots:
	DEFS	4
g_bank_stack:
	DEFS	4
g_bank_sp:
	DEFS	1
	END
