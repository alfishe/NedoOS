	NAME	main(16)
	RSEG	CODE(0)
	RSEG	CSTR(0)
	RSEG	UDATA0(0)
	EXTERN	OS_GETMAINPAGES
	EXTERN	bank_data_peek_u32
	EXTERN	bank_data_peek_u8
	EXTERN	bank_data_poke_u32
	EXTERN	bank_data_poke_u8
	EXTERN	bank_os_new_page
	EXTERN	bank_os_release_page
	EXTERN	bank_pop
	EXTERN	bank_push
	EXTERN	bank_push_slot
	EXTERN	bank_slot_set
	EXTERN	bank_window_current
	PUBLIC	er_init_banks
	EXTERN	exit
	PUBLIC	g_dataPg
	PUBLIC	main
	PUBLIC	main_pg
	EXTERN	os_initstdio
	EXTERN	printf
	EXTERN	r_mock_magic
	EXTERN	r_mock_message
	EXTERN	r_mock_transform
	PUBLIC	residentPg
	PUBLIC	ui_mock_magic
	PUBLIC	ui_mock_message
	PUBLIC	ui_mock_transform
	EXTERN	?CLZ80L_4_06_L00
	RSEG	CODE
resident_call_push:
	PUSH	DE
	LD	DE,(residentPg)
	CALL	bank_push
	POP	DE
	RET
resident_call_pop:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	bank_pop
	LD	SP,IX
	POP	IX
	RET
ui_mock_magic:
	PUSH	DE
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	AF
	CALL	resident_call_push
	LD	(IX-2),A
	CALL	r_mock_magic
	EX	DE,HL
	PUSH	DE
	LD	E,(IX-2)
	CALL	resident_call_pop
	POP	DE
	LD	L,E
	LD	H,D
	LD	SP,IX
	POP	IX
	POP	DE
	RET
ui_mock_transform:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	PUSH	AF
	CALL	resident_call_push
	LD	(IX-3),A
	CALL	r_mock_transform
	LD	(IX-4),A
	LD	E,(IX-3)
	CALL	resident_call_pop
	LD	A,(IX-4)
	LD	SP,IX
	POP	IX
	RET
ui_mock_message:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	CALL	resident_call_push
	LD	(IX-6),A
	LD	L,(IX+4)
	LD	H,(IX+5)
	PUSH	HL
	CALL	r_mock_message
	POP	HL
	LD	E,(IX-6)
	CALL	resident_call_pop
	LD	SP,IX
	POP	IX
	RET
er_init_banks:
	PUSH	BC
	PUSH	DE
	CALL	OS_GETMAINPAGES
	LD	(main_pg),HL
	LD	(main_pg+2),BC
	LD	A,(main_pg)
	LD	(residentPg),A
	LD	C,A
	LD	E,0
	CALL	bank_slot_set
	XOR	A
	LD	(g_dataPg),A
	LD	DE,g_dataPg
	CALL	bank_os_new_page
	OR	A
	JR	Z,?0011
?0010:
	LD	BC,(g_dataPg)
	LD	E,1
	CALL	bank_slot_set
	LD	HL,60839
	PUSH	HL
	LD	HL,42989
	PUSH	HL
	LD	BC,0
	LD	DE,(g_dataPg)
	CALL	bank_data_poke_u32
	POP	HL
	POP	HL
	LD	HL,0
	PUSH	HL
	LD	HL,1
	PUSH	HL
	LD	BC,4
	LD	DE,(g_dataPg)
	CALL	bank_data_poke_u32
	POP	HL
	POP	HL
	LD	C,190
	PUSH	BC
	LD	BC,8
	LD	DE,(g_dataPg)
	CALL	bank_data_poke_u8
	POP	HL
?0011:
	POP	DE
	POP	BC
	RET
demo_data_bank:
	PUSH	BC
	PUSH	DE
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	AF
	PUSH	AF
	PUSH	AF
	LD	BC,(g_dataPg)
	LD	B,0
	PUSH	BC
	LD	HL,?0012
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	LD	A,(g_dataPg)
	OR	A
	JR	NZ,?0014
?0013:
	LD	HL,?0015
	PUSH	HL
	CALL	printf
	POP	AF
	JP	?0019
?0014:
	LD	BC,0
	LD	DE,(g_dataPg)
	CALL	bank_data_peek_u32
	LD	(IX-4),L
	LD	(IX-3),H
	LD	(IX-2),C
	LD	(IX-1),B
	LD	BC,8
	LD	DE,(g_dataPg)
	CALL	bank_data_peek_u8
	LD	(IX-6),A
	LD	C,A
	LD	B,0
	PUSH	BC
	LD	L,(IX-2)
	LD	H,(IX-1)
	PUSH	HL
	LD	L,(IX-4)
	LD	H,(IX-3)
	PUSH	HL
	LD	HL,?0016
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
	POP	AF
	LD	C,239
	PUSH	BC
	LD	BC,8
	LD	DE,(g_dataPg)
	CALL	bank_data_poke_u8
	POP	HL
	LD	BC,8
	LD	DE,(g_dataPg)
	CALL	bank_data_peek_u8
	LD	(IX-6),A
	LD	C,A
	LD	B,0
	PUSH	BC
	LD	HL,?0017
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	CALL	bank_window_current
	LD	(IX-5),A
	LD	BC,(g_dataPg)
	LD	B,0
	PUSH	BC
	LD	BC,(residentPg)
	LD	B,0
	PUSH	BC
	LD	C,A
	LD	B,0
	PUSH	BC
	LD	HL,?0018
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
	POP	AF
?0019:
	LD	SP,IX
	POP	IX
	POP	DE
	POP	BC
	RET
demo_resident_bank:
	PUSH	BC
	PUSH	DE
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	HL,65486
	ADD	HL,SP
	LD	SP,HL
	LD	BC,(residentPg)
	LD	B,0
	PUSH	BC
	LD	HL,?0020
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	CALL	ui_mock_magic
	PUSH	HL
	POP	IY
	LD	BC,21070
	PUSH	BC
	PUSH	HL
	LD	HL,?0021
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
	LD	(IX-50),66
	LD	E,(IX-50)
	CALL	ui_mock_transform
	LD	(IX-49),A
	LD	A,(IX-50)
	XOR	165
	LD	C,A
	LD	B,0
	PUSH	BC
	LD	C,(IX-49)
	LD	B,0
	PUSH	BC
	LD	C,(IX-50)
	LD	B,0
	PUSH	BC
	LD	HL,?0022
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
	POP	AF
	LD	HL,?0023
	PUSH	HL
	LD	C,48
	LD	HL,4
	ADD	HL,SP
	LD	E,L
	LD	D,H
	CALL	ui_mock_message
	POP	HL
	LD	HL,2
	ADD	HL,SP
	PUSH	HL
	LD	HL,?0024
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	LD	SP,IX
	POP	IX
	POP	IY
	POP	DE
	POP	BC
	RET
demo_nested_map:
	PUSH	BC
	PUSH	DE
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	AF
	PUSH	AF
	PUSH	AF
	LD	HL,?0025
	PUSH	HL
	CALL	printf
	POP	AF
	LD	E,0
	CALL	bank_push_slot
	LD	(IX-2),A
	CALL	ui_mock_magic
	LD	BC,0
	LD	DE,(g_dataPg)
	CALL	bank_data_peek_u32
	LD	(IX-6),L
	LD	(IX-5),H
	LD	(IX-4),C
	LD	(IX-3),B
	PUSH	BC
	PUSH	HL
	LD	HL,?0026
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
	LD	E,(IX-2)
	CALL	bank_pop
	LD	BC,0
	LD	DE,(g_dataPg)
	CALL	bank_data_peek_u32
	LD	(IX-6),L
	LD	(IX-5),H
	LD	(IX-4),C
	LD	(IX-3),B
	PUSH	BC
	PUSH	HL
	LD	HL,?0027
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
	LD	SP,IX
	POP	IX
	POP	DE
	POP	BC
	RET
main:
	CALL	os_initstdio
	CALL	er_init_banks
	LD	HL,?0028
	PUSH	HL
	CALL	printf
	POP	AF
	LD	HL,?0029
	PUSH	HL
	CALL	printf
	POP	AF
	CALL	demo_data_bank
	LD	HL,?0030
	PUSH	HL
	CALL	printf
	POP	AF
	CALL	demo_resident_bank
	LD	HL,?0030
	PUSH	HL
	CALL	printf
	POP	AF
	CALL	demo_nested_map
	LD	A,(g_dataPg)
	OR	A
	JR	Z,?0032
?0031:
	LD	DE,(g_dataPg)
	CALL	bank_os_release_page
?0032:
	LD	DE,0
	CALL	exit
	RET
	RSEG	CSTR
?0012:
	DEFB	'--- data bank (page %u @ C000) ---'
	DEFB	13,10,0
?0015:
	DEFB	'  OS_NEWPAGE failed'
	DEFB	13,10,0
?0016:
	DEFB	'  sig=0x%lX payload=0x%02X'
	DEFB	13,10,0
?0017:
	DEFB	'  after poke payload=0x%02X'
	DEFB	13,10,0
?0018:
	DEFB	'  C000 maps page %u (resident=%u data=%u)'
	DEFB	13,10,0
?0020:
	DEFB	'--- resident bank (page %u @ C000) ---'
	DEFB	13,10,0
?0021:
	DEFB	'  r_mock_magic()=0x%04X (expect 0x%04X)'
	DEFB	13,10,0
?0022:
	DEFB	'  r_mock_transform(0x%02X)=0x%02X (expect 0x%02X)'
	DEFB	13,10,0
?0023:
	DEFB	'hello'
	DEFB	0
?0024:
	DEFB	'  r_mock_message: %s'
	DEFB	13,10,0
?0025:
	DEFB	'--- nested map: resident -> data ---'
	DEFB	13,10,0
?0026:
	DEFB	'  read data sig while resident mapped: 0x%lX'
	DEFB	13,10,0
?0027:
	DEFB	'  read data sig after restore: 0x%lX'
	DEFB	13,10,0
?0028:
	DEFB	'emptyres: bank window toolkit demo'
	DEFB	13,10,0
?0029:
	DEFB	'main @ 0100-BFFF, bank @ C000'
	DEFB	13,10,13,10,0
?0030:
	DEFB	13,10,0
	RSEG	UDATA0
residentPg:
	DEFS	1
g_dataPg:
	DEFS	1
main_pg:
	DEFS	7
	END
