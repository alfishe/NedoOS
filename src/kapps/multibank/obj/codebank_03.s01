	NAME	codebank_03(16)
	RSEG	CODE_RESIDENT(0)
	RSEG	CSTR(0)
	EXTERN	mb_report_bank
	EXTERN	puts
	PUBLIC	r_bank_entry
	EXTERN	?CLZ80L_4_06_L00
	RSEG	CODE_RESIDENT
r_bank_entry:
	PUSH	DE
	LD	DE,3
	CALL	mb_report_bank
	LD	DE,?0010
	CALL	puts
	POP	DE
	RET
	RSEG	CSTR
?0010:
	DEFB	'bank03 ok'
	DEFB	13,10,0
	END
