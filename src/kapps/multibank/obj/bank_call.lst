      1            #include "mb_inc.h"
      2            #include "mb_plug.h"
      3            #include "bank_jt.h"
      4            
      5            /*
      6             * Plan JT wrappers: map bank @8000, CALL slot, restore previous @8000.
      7             *
      8             * Override the trio together (before #ifndef below), e.g.:
      9             *
     10             *   Always return to a session bank (e.g. bank01):
     11             *     #define MB_BANK_SAVE()
     12             *     #define MB_BANK_ENTER(idx) OS_SETPG8000(g_bankPg[(idx)])
     13             *     #define MB_BANK_LEAVE()    OS_SETPG8000(g_bankPg[0])
     14             *
     15             *   Full no-op (page already correct):
     16             *     #define MB_BANK_SAVE()
     17             *     #define MB_BANK_ENTER(idx) ((void)0)
     18             *     #define MB_BANK_LEAVE()    ((void)0)
     19             *
     20             * Empty SAVE = "#define MB_BANK_SAVE()" ? true no-op (no tokens).
     21             * Do not put ';' after MB_BANK_SAVE() in wrappers (C89 declaration rules).
     22             * Default SAVE includes its own trailing ';'.
     23             */
     24            
     25            #ifndef MB_BANK_SAVE
     26            #define MB_BANK_SAVE() \
     27                    unsigned char _mb_saved8000 = mb_code_current();
     28            #define MB_BANK_ENTER(idx) OS_SETPG8000(g_bankPg[(idx)])
     29            #define MB_BANK_LEAVE()    OS_SETPG8000(_mb_saved8000)
     30            #endif
     31            
     32            void mb_run_bank(unsigned char idx0)
     33            {
     34                    void (*fn)(void);
     35                    MB_BANK_SAVE()
     36            
     37                    if (idx0 >= MB_BANK_COUNT || g_bankPg[idx0] == 0u)
     38                    {
     39                            MB_BANK_LEAVE();
     40                            return;
     41                    }
     42            
     43                    OS_SETPG8000(g_bankPg[idx0]);
     44                    fn = (void (*)(void))MB_JT_ADDR(MB_JT_ENTRY);
     45                    fn();
     46                    MB_BANK_LEAVE();
     47            }
     48            
     49            /* mbgen:banks-begin */
     50            void bank1(void)
     51            {
     52                    mb_run_bank(0u);
     53            }
     54            
     55            void bank2(void)
     56            {
     57                    mb_run_bank(1u);
     58            }
     59            
     60            void bank3(void)
     61            {
     62                    mb_run_bank(2u);
     63            }
