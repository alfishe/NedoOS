	NAME	main(16)
	RSEG	CODE(0)
	RSEG	CSTR(0)
	EXTERN	bank1
	EXTERN	bank2
	EXTERN	bank3
	EXTERN	exit
	EXTERN	g_bankPg
	EXTERN	g_dataPg
	EXTERN	g_main_pg
	EXTERN	getchar
	PUBLIC	main
	EXTERN	mb_init
	EXTERN	mb_load_bank_bin
	EXTERN	mb_shutdown
	EXTERN	os_initstdio
	EXTERN	printf
	EXTERN	sprintf
	EXTERN	?CLZ80L_4_06_L00
	EXTERN	?STRCPY_L11
	EXTERN	?STRCAT_L11
	RSEG	CODE
mb_fmt_bank_name:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	LD	D,0
	INC	DE
	PUSH	DE
	LD	HL,?0010
	PUSH	HL
	PUSH	BC
	CALL	sprintf
	POP	AF
	POP	AF
	POP	AF
	LD	SP,IX
	POP	IX
	RET
mb_try_load:
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	LD	HL,65480
	ADD	HL,SP
	LD	SP,HL
	PUSH	BC
	POP	IY
	LD	HL,40
	ADD	HL,SP
	LD	C,L
	LD	B,H
	CALL	mb_fmt_bank_name
	LD	DE,?0011
	LD	HL,0
	ADD	HL,SP
	CALL	?STRCPY_L11
	LD	HL,40
	ADD	HL,SP
	LD	E,L
	LD	D,H
	LD	HL,0
	ADD	HL,SP
	CALL	?STRCAT_L11
	PUSH	IY
	POP	BC
	LD	HL,0
	ADD	HL,SP
	LD	E,L
	LD	D,H
	CALL	mb_load_bank_bin
	OR	A
	JR	Z,?0013
?0012:
	LD	A,1
	JR	?0015
?0013:
	LD	DE,?0014
	LD	HL,0
	ADD	HL,SP
	CALL	?STRCPY_L11
	LD	HL,40
	ADD	HL,SP
	LD	E,L
	LD	D,H
	LD	HL,0
	ADD	HL,SP
	CALL	?STRCAT_L11
	PUSH	IY
	POP	BC
	LD	HL,0
	ADD	HL,SP
	LD	E,L
	LD	D,H
	CALL	mb_load_bank_bin
?0015:
	LD	SP,IX
	POP	IX
	POP	IY
	RET
demo_load_banks:
	PUSH	BC
	PUSH	DE
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	HL,65520
	ADD	HL,SP
	LD	SP,HL
	LD	IYH,1
	LD	HL,?0016
	PUSH	HL
	CALL	printf
	POP	AF
	LD	IYL,0
?0018:
	LD	A,IYL
	CP	3
	JR	NC,?0017
?0019:
	LD	HL,0
	ADD	HL,SP
	LD	C,L
	LD	B,H
	LD	E,IYL
	CALL	mb_fmt_bank_name
	LD	C,IYL
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	C,L
	LD	B,H
	LD	E,IYL
	CALL	mb_try_load
	OR	A
	JR	NZ,?0022
?0021:
	LD	HL,0
	ADD	HL,SP
	PUSH	HL
	LD	HL,?0023
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	LD	IYH,0
	JR	?0024
?0022:
	LD	C,IYL
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	C,(HL)
	LD	B,0
	PUSH	BC
	LD	HL,2
	ADD	HL,SP
	PUSH	HL
	LD	HL,?0025
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
?0024:
	INC	IYL
	JR	?0018
?0017:
	LD	A,IYH
	LD	SP,IX
	POP	IX
	POP	IY
	POP	DE
	POP	BC
	RET
demo_run_banks:
	LD	HL,?0026
	PUSH	HL
	CALL	printf
	POP	AF
	CALL	bank1
	CALL	bank2
	CALL	bank3
	RET
main:
	CALL	os_initstdio
	CALL	mb_init
	LD	HL,?0027
	PUSH	HL
	CALL	printf
	POP	AF
	LD	BC,(g_main_pg+1)
	LD	B,0
	PUSH	BC
	LD	BC,(g_dataPg)
	LD	B,0
	PUSH	BC
	LD	HL,?0028
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	POP	AF
	CALL	demo_load_banks
	OR	A
	JR	NZ,?0030
?0029:
	LD	HL,?0031
	PUSH	HL
	CALL	printf
	POP	AF
	CALL	mb_shutdown
	LD	DE,1
	CALL	exit
?0030:
	LD	HL,?0032
	PUSH	HL
	CALL	printf
	POP	AF
	CALL	demo_run_banks
	CALL	mb_shutdown
	CALL	getchar
	LD	DE,0
	CALL	exit
	RET
	RSEG	CSTR
?0010:
	DEFB	'codeB_%02u.bin'
	DEFB	0
?0011:
	DEFB	'multibank/'
	DEFB	0
?0014:
	DEFB	'bin/multibank/'
	DEFB	0
?0016:
	DEFB	'--- load overlays ---'
	DEFB	13,10,0
?0023:
	DEFB	'  FAIL %s'
	DEFB	13,10,0
?0025:
	DEFB	'  OK   %s -> page %u'
	DEFB	13,10,0
?0026:
	DEFB	'--- JT call bank1/2/3 ---'
	DEFB	13,10,0
?0027:
	DEFB	'multibank JT: root 0100-7FFF, code @8000, data @C000'
	DEFB	13,10,0
?0028:
	DEFB	'  data pg %u, cold window_2=%u'
	DEFB	13,10,0
?0031:
	DEFB	'Load failed. Need /bin/multibank/codeB_0N.bin'
	DEFB	13,10,0
?0032:
	DEFB	13,10,0
	END
