	NAME	mb_core(16)
	RSEG	CODE(0)
	RSEG	CSTR(0)
	RSEG	CONST(0)
	RSEG	UDATA0(0)
	EXTERN	OS_CLOSEHANDLE
	EXTERN	OS_DELPAGE
	EXTERN	OS_GETFILESIZE
	EXTERN	OS_GETMAINPAGES
	EXTERN	OS_NEWPAGE
	EXTERN	OS_OPENHANDLE
	EXTERN	OS_READHANDLE
	EXTERN	OS_SETPG8000
	EXTERN	OS_SETPGC000
	EXTERN	force_helpers
	PUBLIC	g_bankPg
	PUBLIC	g_dataPg
	PUBLIC	g_main_pg
	PUBLIC	mb_code_current
	PUBLIC	mb_code_map
	PUBLIC	mb_code_pop
	PUBLIC	mb_code_push
	PUBLIC	mb_data_current
	PUBLIC	mb_data_fill
	PUBLIC	mb_data_map
	PUBLIC	mb_data_peek_u32
	PUBLIC	mb_data_poke_u32
	PUBLIC	mb_data_pop
	PUBLIC	mb_data_push
	PUBLIC	mb_data_select
	PUBLIC	mb_init
	PUBLIC	mb_load_bank_bin
	PUBLIC	mb_os_new_page
	PUBLIC	mb_os_release_page
	PUBLIC	mb_report_bank
	PUBLIC	mb_shutdown
	PUBLIC	netbuf
	EXTERN	printf
	EXTERN	puts
	EXTERN	?CLZ80L_4_06_L00
	RSEG	CODE
mb_code_current:
	PUSH	BC
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	AF
	PUSH	AF
	PUSH	AF
	PUSH	AF
	CALL	OS_GETMAINPAGES
	LD	(IX-8),L
	LD	(IX-7),H
	LD	(IX-6),C
	LD	(IX-5),B
	LD	A,(IX-7)
	LD	SP,IX
	POP	IX
	POP	BC
	RET
mb_code_map:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	OS_SETPG8000
	LD	SP,IX
	POP	IX
	RET
mb_data_current:
	PUSH	BC
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	AF
	PUSH	AF
	PUSH	AF
	PUSH	AF
	CALL	OS_GETMAINPAGES
	LD	(IX-8),L
	LD	(IX-7),H
	LD	(IX-6),C
	LD	(IX-5),B
	LD	A,(IX-8)
	LD	SP,IX
	POP	IX
	POP	BC
	RET
mb_data_map:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	OS_SETPGC000
	LD	SP,IX
	POP	IX
	RET
mb_os_new_page:
	PUSH	BC
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	OS_NEWPAGE
	PUSH	HL
	POP	IY
	LD	C,L
	LD	B,H
	LD	HL,255
	AND	A
	SBC	HL,BC
	JR	NC,?0011
?0010:
	XOR	A
	JR	?0012
?0011:
	PUSH	IY
	POP	HL
	PUSH	IY
	LD	L,(IX-2)
	LD	H,(IX-1)
	POP	BC
	LD	(HL),C
	LD	A,1
?0012:
	LD	SP,IX
	POP	IX
	POP	IY
	POP	BC
	RET
mb_os_release_page:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	INC	E
	DEC	E
	JR	Z,?0014
?0013:
	LD	E,(IX-2)
	CALL	OS_DELPAGE
?0014:
	LD	SP,IX
	POP	IX
	RET
mb_code_push:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	mb_code_current
	LD	D,A
	PUSH	DE
	CALL	mb_code_map
	POP	DE
	LD	A,D
	LD	SP,IX
	POP	IX
	RET
mb_code_pop:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	mb_code_map
	LD	SP,IX
	POP	IX
	RET
mb_data_push:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	mb_data_current
	LD	D,A
	PUSH	DE
	CALL	mb_data_map
	POP	DE
	LD	A,D
	LD	SP,IX
	POP	IX
	RET
mb_data_pop:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	CALL	mb_data_map
	LD	SP,IX
	POP	IX
	RET
mb_data_poke_u32:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	CALL	mb_data_push
	LD	(IX-6),A
	LD	A,192
	ADD	A,B
	LD	B,A
	LD	L,C
	LD	H,B
	LD	C,(IX+6)
	LD	B,(IX+7)
	LD	E,(IX+4)
	LD	D,(IX+5)
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	(HL),C
	INC	HL
	LD	(HL),B
	LD	E,(IX-6)
	CALL	mb_data_pop
	LD	SP,IX
	POP	IX
	RET
mb_data_peek_u32:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	PUSH	AF
	PUSH	AF
	CALL	mb_data_push
	LD	(IX-10),A
	LD	A,192
	ADD	A,B
	LD	B,A
	LD	L,C
	LD	H,B
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	EX	DE,HL
	LD	(IX-8),L
	LD	(IX-7),H
	LD	(IX-6),C
	LD	(IX-5),B
	LD	E,(IX-10)
	CALL	mb_data_pop
	LD	C,(IX-6)
	LD	B,(IX-5)
	LD	L,(IX-8)
	LD	H,(IX-7)
	LD	SP,IX
	POP	IX
	RET
mb_data_fill:
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	PUSH	AF
	CALL	mb_data_push
	LD	(IX-6),A
	LD	IY,0
?0016:
	LD	BC,16384
	PUSH	IY
	POP	HL
	AND	A
	SBC	HL,BC
	JR	NC,?0015
?0017:
	PUSH	IY
	POP	HL
	LD	A,192
	ADD	A,H
	LD	H,A
	LD	B,(IX-2)
	LD	(HL),B
	INC	IY
	JR	?0016
?0015:
	LD	E,(IX-6)
	CALL	mb_data_pop
	LD	SP,IX
	POP	IX
	POP	IY
	RET
mb_report_bank:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	PUSH	DE
	LD	HL,g_bank_fmt
	PUSH	HL
	CALL	printf
	POP	AF
	POP	AF
	LD	SP,IX
	POP	IX
	RET
mb_data_select:
	PUSH	DE
	LD	A,(g_dataPg)
	OR	A
	JR	Z,?0020
?0019:
	LD	DE,(g_dataPg)
	CALL	mb_data_map
	LD	HL,49168
	LD	(netbuf),HL
	JR	?0021
?0020:
	LD	HL,0
	LD	(netbuf),HL
?0021:
	POP	DE
	RET
mb_init:
	PUSH	BC
	PUSH	DE
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	AF
	CALL	OS_GETMAINPAGES
	LD	(g_main_pg),HL
	LD	(g_main_pg+2),BC
	LD	DE,?0022
	CALL	puts
	LD	HL,?0022
	PUSH	HL
	CALL	printf
	POP	AF
	CALL	force_helpers
	LD	(IX-2),0
?0024:
	LD	A,(IX-2)
	CP	3
	JR	NC,?0023
?0025:
	LD	C,(IX-2)
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	(HL),0
	INC	(IX-2)
	JR	?0024
?0023:
	XOR	A
	LD	(g_dataPg),A
	LD	HL,0
	LD	(netbuf),HL
	LD	DE,g_dataPg
	CALL	mb_os_new_page
	OR	A
	JR	Z,?0028
?0027:
	LD	C,0
	LD	DE,(g_dataPg)
	CALL	mb_data_fill
	CALL	mb_data_select
	LD	HL,19778
	PUSH	HL
	LD	HL,17483
	PUSH	HL
	LD	BC,0
	LD	DE,(g_dataPg)
	CALL	mb_data_poke_u32
	POP	HL
	POP	HL
	CALL	mb_data_select
?0028:
	LD	SP,IX
	POP	IX
	POP	DE
	POP	BC
	RET
mb_shutdown:
	PUSH	BC
	PUSH	DE
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	LD	E,0
?0030:
	LD	A,E
	CP	3
	JR	NC,?0029
?0031:
	LD	C,E
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	A,(HL)
	OR	A
	JR	Z,?0034
?0033:
	PUSH	DE
	LD	C,E
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	E,(HL)
	CALL	mb_os_release_page
	POP	DE
	LD	C,E
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	(HL),0
?0034:
	INC	E
	JR	?0030
?0029:
	LD	A,(g_dataPg)
	OR	A
	JR	Z,?0036
?0035:
	PUSH	DE
	LD	A,(g_dataPg)
	LD	E,A
	CALL	mb_os_release_page
	POP	DE
	XOR	A
	LD	(g_dataPg),A
	LD	HL,0
	LD	(netbuf),HL
?0036:
	LD	SP,IX
	POP	IX
	POP	DE
	POP	BC
	RET
mb_open_ok:
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	LD	D,0
	LD	A,E
	OR	D
	JR	NZ,?0057
	LD	A,1
	JR	?0058
?0057:
	XOR	A
?0058:
	LD	SP,IX
	POP	IX
	RET
mb_load_bank_bin:
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	BC
	PUSH	DE
	LD	HL,65526
	ADD	HL,SP
	LD	SP,HL
	LD	A,C
	OR	B
	JR	Z,?0039
	LD	A,(IX-4)
	OR	(IX-3)
	JR	NZ,?0038
?0039:
?0040:
?0037:
	XOR	A
	JP	?0055
?0038:
	LD	HL,0
	ADD	HL,SP
	LD	E,L
	LD	D,H
	CALL	mb_os_new_page
	OR	A
	JR	NZ,?0042
?0041:
	XOR	A
	JP	?0055
?0042:
	LD	C,128
	LD	E,(IX-4)
	LD	D,(IX-3)
	CALL	OS_OPENHANDLE
	LD	(IX-12),L
	LD	(IX-11),H
	EX	DE,HL
	CALL	mb_open_ok
	OR	A
	JR	NZ,?0044
?0043:
	LD	E,(IX-14)
	CALL	mb_os_release_page
	XOR	A
	JP	?0055
?0044:
	LD	E,(IX-12)
	LD	D,(IX-11)
	CALL	OS_GETFILESIZE
	LD	(IX-10),L
	LD	(IX-9),H
	LD	(IX-8),C
	LD	(IX-7),B
	LD	A,L
	OR	H
	OR	C
	OR	B
	JR	Z,?0047
	AND	A
	LD	HL,16384
	LD	C,(IX-10)
	LD	B,(IX-9)
	SBC	HL,BC
	LD	HL,0
	LD	C,(IX-8)
	LD	B,(IX-7)
	SBC	HL,BC
	JR	NC,?0046
?0047:
?0048:
?0045:
	LD	E,(IX-12)
	LD	D,(IX-11)
	CALL	OS_CLOSEHANDLE
	LD	E,(IX-14)
	CALL	mb_os_release_page
	XOR	A
	JR	?0055
?0046:
	LD	E,(IX-14)
	CALL	mb_code_push
	LD	(IX-13),A
	LD	IY,0
?0050:
	LD	BC,16384
	PUSH	IY
	POP	HL
	AND	A
	SBC	HL,BC
	JR	NC,?0049
?0051:
	PUSH	IY
	POP	HL
	LD	A,128
	ADD	A,H
	LD	H,A
	LD	(HL),0
	INC	IY
	JR	?0050
?0049:
	LD	L,(IX-10)
	LD	H,(IX-9)
	PUSH	HL
	LD	C,(IX-12)
	LD	B,(IX-11)
	LD	DE,32768
	CALL	OS_READHANDLE
	POP	AF
	LD	(IX-6),L
	LD	(IX-5),H
	LD	E,(IX-12)
	LD	D,(IX-11)
	CALL	OS_CLOSEHANDLE
	LD	E,(IX-13)
	CALL	mb_code_pop
	LD	L,(IX-10)
	LD	H,(IX-9)
	LD	C,(IX-6)
	LD	B,(IX-5)
	AND	A
	SBC	HL,BC
	JR	Z,?0054
?0053:
	LD	E,(IX-14)
	CALL	mb_os_release_page
	XOR	A
	JR	?0055
?0054:
	LD	B,(IX-14)
	LD	L,(IX-2)
	LD	H,(IX-1)
	LD	(HL),B
	LD	A,1
?0055:
	LD	SP,IX
	POP	IX
	POP	IY
	RET
	RSEG	CSTR
?0022:
	DEFB	0
	RSEG	CONST
g_bank_fmt:
	DEFB	'JT slot0 from codebank %u'
	DEFB	13,10,0
	RSEG	UDATA0
g_bankPg:
	DEFS	3
g_dataPg:
	DEFS	1
g_main_pg:
	DEFS	7
netbuf:
	DEFS	2
	END
