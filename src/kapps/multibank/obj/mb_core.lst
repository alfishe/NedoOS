    180            /* ---- overlay load (NedoOS: never test fp==0) ---- */
    181            
    182            static unsigned char mb_open_ok(FILE *fp)
    183            {
    184                    return (((unsigned int)fp) & 0xffu) == 0u;
    185            }
    186            
    187            unsigned char mb_load_bank_bin(const char *path, unsigned char *page_out)
    188            {
    189                    FILE *fp;
    190                    unsigned char page;
    191                    unsigned char saved;
    192                    unsigned long sz;
    193                    unsigned int nread;
    194                    unsigned int i;
    195            
    196                    if (page_out == 0 || path == 0)
    197                            return 0u;
    198            
    199                    if (!mb_os_new_page(&page))
    200                            return 0u;
    201            
    202                    fp = OS_OPENHANDLE((unsigned char *)path, 0x80u);
    203                    if (!mb_open_ok(fp))
    204                    {
    205                            mb_os_release_page(page);
    206                            return 0u;
    207                    }
    208            
    209                    sz = OS_GETFILESIZE(fp);
    210                    if (sz == 0ul || sz > (unsigned long)MB_PAGE_SIZE)
    211                    {
    212                            OS_CLOSEHANDLE(fp);
    213                            mb_os_release_page(page);
    214                            return 0u;
    215                    }
    216            
    217                    saved = mb_code_push(page);
    218            
    219                    for (i = 0u; i < MB_PAGE_SIZE; i++)
    220                            ((unsigned char *)MB_CODE_ADDR)[i] = 0u;
    221            
    222                    nread = OS_READHANDLE((unsigned char *)MB_CODE_ADDR, fp, (unsigned int)sz);
    223                    OS_CLOSEHANDLE(fp);
    224                    mb_code_pop(saved);
    225            
    226                    if (nread != (unsigned int)sz)
    227                    {
    228                            mb_os_release_page(page);
    229                            return 0u;
    230                    }
    231            
    232                    *page_out = page;
    233                    return 1u;
    234            }

