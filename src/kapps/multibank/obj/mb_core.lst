     36            void mb_data_map(unsigned char page)
     37            {
     38                    OS_SETPGC000(page);
     39            }
     40            
     41            unsigned char mb_os_new_page(unsigned char *page_out)
     42            {
     43                    unsigned int pg;
     44            
     45                    pg = OS_NEWPAGE();
     46                    if (pg > 255u)
     47                            return 0u;
     48                    *page_out = (unsigned char)pg;
     49                    return 1u;
     50            }
     51            
     52            void mb_os_release_page(unsigned char page)
     53            {
     54                    if (page != 0u)
     55                            OS_DELPAGE(page);
     56            }
     57            
     58            unsigned char mb_code_push(unsigned char page)
     59            {
     60                    unsigned char saved;
     61            
     62                    saved = mb_code_current();
     63                    mb_code_map(page);
     64                    return saved;
     65            }
     66            
     67            void mb_code_pop(unsigned char saved)
     68            {
     69                    mb_code_map(saved);
     70            }
     71            
