    118            
    119            void mb_report_bank(unsigned int bank_nr)
    120            {
    121                    printf(g_bank_fmt, bank_nr);
    122            }
    123            
    124            void mb_data_select(void)
    125            {
    126                    if (g_dataPg != 0u)
    127                    {
    128                            mb_data_map(g_dataPg);
    129                            netbuf = (unsigned char *)(MB_DATA_ADDR + MB_NETBUF_OFF);
    130                    }
    131                    else
    132                            netbuf = 0;
    133            }
    134            
    135            void mb_init(void)
    136            {
    137                    unsigned char i;
    138            
    139                    g_main_pg.l = OS_GETMAINPAGES();
    140            
    141                    /* Force-link symbols banks CALL by absolute address. */
    142                    puts("");
    143                    printf("");
    144                    force_helpers();
    145            
    146                    for (i = 0u; i < MB_BANK_COUNT; i++)
    147                            g_bankPg[i] = 0u;
    148            
    149                    g_dataPg = 0u;
    150                    netbuf = 0;
    151                    if (mb_os_new_page(&g_dataPg))
    152                    {
    153                            mb_data_fill(g_dataPg, 0u);
    154                            mb_data_select();
    155                            mb_data_poke_u32(g_dataPg, MB_DATA_SIG_OFF, MB_DATA_SIG_MAGIC);
    156                            mb_data_select();
    157                    }
    158            }
    159            
    160            void mb_shutdown(void)
    161            {
    162                    unsigned char i;
    163            
    164                    for (i = 0u; i < MB_BANK_COUNT; i++)
    165                    {
    166                            if (g_bankPg[i] != 0u)
    167                            {
    168                                    mb_os_release_page(g_bankPg[i]);
    169                                    g_bankPg[i] = 0u;
    170                            }
    171                    }
    172                    if (g_dataPg != 0u)
    173                    {
    174                            mb_os_release_page(g_dataPg);
    175                            g_dataPg = 0u;
    176                            netbuf = 0;
    177                    }
    178            }
