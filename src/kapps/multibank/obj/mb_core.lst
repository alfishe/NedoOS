     12            
     13            /* ---- CODE / DATA window ---- */
     14            
     15            unsigned char mb_code_current(void)
     16            {
     17                    union APP_PAGES cur;
     18            
     19                    cur.l = OS_GETMAINPAGES();
     20                    return cur.pgs.window_2;
     21            }
     22            
     23            void mb_code_map(unsigned char page)
     24            {
     25                    OS_SETPG8000(page);
     26            }
     27            
     28            unsigned char mb_data_current(void)
     29            {
     30                    union APP_PAGES cur;
     31            
     32                    cur.l = OS_GETMAINPAGES();
     33                    return cur.pgs.window_3;
     34            }
