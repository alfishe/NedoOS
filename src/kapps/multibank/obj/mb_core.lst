     85            
     86            void mb_data_poke_u32(unsigned char page, unsigned int off, unsigned long val)
     87            {
     88                    unsigned char saved;
     89            
     90                    saved = mb_data_push(page);
     91                    *(unsigned long *)(MB_DATA_ADDR + off) = val;
     92                    mb_data_pop(saved);
