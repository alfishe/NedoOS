     94            
     95            unsigned long mb_data_peek_u32(unsigned char page, unsigned int off)
     96            {
     97                    unsigned char saved;
     98                    unsigned long v;
     99            
    100                    saved = mb_data_push(page);
    101                    v = *(unsigned long *)(MB_DATA_ADDR + off);
    102                    mb_data_pop(saved);
    103                    return v;
    104            }
    105            
    106            void mb_data_fill(unsigned char page, unsigned char fill_byte)
    107            {
    108                    unsigned char saved;
    109                    unsigned int i;
    110            
    111                    saved = mb_data_push(page);
    112                    for (i = 0u; i < MB_PAGE_SIZE; i++)
    113                            ((unsigned char *)MB_DATA_ADDR)[i] = fill_byte;
    114                    mb_data_pop(saved);
    115            }
