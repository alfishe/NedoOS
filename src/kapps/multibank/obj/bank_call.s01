	NAME	bank_call(16)
	RSEG	CODE(0)
	EXTERN	OS_SETPG8000
	PUBLIC	bank1
	PUBLIC	bank2
	PUBLIC	bank3
	EXTERN	g_bankPg
	EXTERN	mb_code_current
	PUBLIC	mb_run_bank
	EXTERN	?CLZ80L_4_06_L00
	EXTERN	?CALL_IND_L09
	RSEG	CODE
mb_run_bank:
	PUSH	BC
	PUSH	IY
	PUSH	IX
	LD	IX,0
	ADD	IX,SP
	PUSH	DE
	PUSH	AF
	CALL	mb_code_current
	LD	(IX-4),A
	LD	A,E
	CP	3
	JR	NC,?0012
	LD	C,(IX-2)
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	A,(HL)
	OR	A
	JR	NZ,?0011
?0012:
?0013:
?0010:
	LD	E,(IX-4)
	CALL	OS_SETPG8000
	JR	?0014
?0011:
	LD	C,(IX-2)
	LD	B,0
	LD	HL,g_bankPg
	ADD	HL,BC
	LD	E,(HL)
	CALL	OS_SETPG8000
	LD	IY,32768
	PUSH	IY
	POP	HL
	CALL	?CALL_IND_L09
	LD	E,(IX-4)
	CALL	OS_SETPG8000
?0014:
	LD	SP,IX
	POP	IX
	POP	IY
	POP	BC
	RET
bank1:
	PUSH	DE
	LD	E,0
	CALL	mb_run_bank
	POP	DE
	RET
bank2:
	PUSH	DE
	LD	E,1
	CALL	mb_run_bank
	POP	DE
	RET
bank3:
	PUSH	DE
	LD	E,2
	CALL	mb_run_bank
	POP	DE
	RET
	END
