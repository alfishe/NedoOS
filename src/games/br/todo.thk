      x+=2;
      one_qu(x,y,n); n++;
      x+=2;
      one_qu(x,y,n); n++;
      y+=16;
      one_qu(x,y,n); n++;
      y+=16;
      one_qu(x,y,n); n++;
      x-=2;
      one_qu(x,y,n); n++;
      x-=2;
      one_qu(x,y,n);
      x+=8;
      y-=16;
