;клипирование снизу
prsprcropbottom
;a=sprbottom
;?1=x = -(sprmaxwid-1)..159 (кодируется как x+(sprmaxwid-1))
;c?2=y = -(sprmaxhgt-1)..199 (кодируется как y+(sprmaxhgt-1))
;?3=sprhgt
;hl=scr
        ;sub 201
        ;cpl
        ;add a,?3 ;sprhgt
        ;ld ?5,a ;sprvisiblehgt = sprhgt-(sprbottom-200)
        sub 200
        sub ?3 ;sprhgt
        ld ?6,a ;-sprvisiblehgt = sprbottom-200-sprhgt
        jp prsprcropygo

prsprcroptop
;a=sprtop
;?1=x = -(sprmaxwid-1)..159 (кодируется как x+(sprmaxwid-1))
;c?2=y = -(sprmaxhgt-1)..199 (кодируется как y+(sprmaxhgt-1))
;?3=sprhgt
;hl=scr неверный
        
        neg ;a=number of lines to crop
        sub ?3 ;sprhgt
        ld ?6,a ;-sprvisiblehgt = -(sprtop+sprhgt) = linestocrop-sprhgt
        add a,?3
        add a,a
;прибавить 2*число скрытых строк к адресу
        add a,ly
        ld ly,a
        jr nc,$+4
        inc hy
        
        ld a,?1 ;x
        sub sprmaxwid-1 ;NC
        rra
        ld h,0x40
        jr nc,$+4
         ld h,0x80
        ld l,a
        
prsprcropygo

;?4=sprwid
        ld a,160+(sprmaxwid-1)
        sub ?1 ;x ;a=расстояние до правой границы экрана
        cp ?4 ;sprwid
        jr c,$+3 ;берём меньшее из sprwid и расстояния до правой границы экрана
         ld a,?4
        ld hx,a
;hx=sprite wid (columns), с учётом границы экрана

        ex de,hl
        ;ld l,?5 ;sprvisiblehgt
        ;dec l
        ;ld b,0
        ld l,?6 ;-sprvisiblehgt
        ld b,-1
        ld h,0x40/32-1
        ld c,l
        add hl,hl
        add hl,hl
        add hl,bc
        add hl,hl
        add hl,hl
        add hl,hl
        ;neghl
        ;add h,0x40
        ld (prsprNscraddpatch),hl ;0x4000 - ((sprvisiblehgt-1)*40)
        ex de,hl

        ld a,?3 ;sprhgt
        add a,?6 ;-sprvisiblehgt
        inc a
        add a,a
        ld (prsprNspraddpatch),a ;2*(sprhgt-sprvisiblehgt)+2

        ;ld a,?5 ;sprvisiblehgt
        ;add a,a
        ;add a,?5
        ;add a,a
        ;neg
        ld a,?6 ;-sprvisiblehgt
        add a,a
        add a,?6
        add a,a
        ld (prsprNpatch),a ;PRSPR24 и т.п. (по 6 байт)        
;hl=scr
        ld bc,40
        jp prsprN

;выравнивание на нужный младший байт адреса:
_lowaddr=256-(24*6)
        ds (_lowaddr-$)&0xff
;младший байт адреса равен 256-(sprvisiblehgt*6)
PRSPR24
        MASKBYTE
        DOWNBYTE
        pop de
PRSPR23
