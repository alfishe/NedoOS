                ClkConfig??T:
;FILE: Eth_Config.c
;000009    void ClkConfig()
;000012            RST_CLK->PER_CLOCK |= (1 << 27);                                //BKP Clock enable
00000000    4817                       	LDR             R0,?lr0000	; 40020000h
00000002    69C1                       	LDR             R1,[R0,#28]
00000004    4A17                       	LDR             R2,?lr0001	; 8000000h
00000006    4311                       	ORRS            R1,R2
00000008    61C1                       	STR             R1,[R0,#28]
;000013            temp = BKP->REG_0E;
0000000A    4A17                       	LDR             R2,?lr0002	; 400D8038h
0000000C    6811                       	LDR             temp?ClkConfig,[R2,#0]
;000014            temp &= 0xFFFFFFC0;
0000000E    0989                       	LSRS            temp?ClkConfig,temp?ClkConfig,#6
00000010    0189                       	LSLS            temp?ClkConfig,temp?ClkConfig,#6
;000015            BKP->REG_0E = temp | (7 << 3) | 7;                              // SelectRI = 0x7, LOW = 0x7; (for core frequency more then 80 MHz);
00000012    233F                       	MOVS            R3,#63
00000014    4319                       	ORRS            temp?ClkConfig,R3
00000016    6011                       	STR             temp?ClkConfig,[R2,#0]
;000019            RST_CLK->HS_CONTROL=0x00000005;                                 //HSE On, Oscillator mode; HSE2 On, Oscillator mode
00000018    2105                       	MOVS            R1,#5
0000001A    6081                       	STR             R1,[R0,#8]
;000024            while((RST_CLK->CLOCK_STATUS&0x0C)!=0x0C);              //Wait until HSE and HSE2 not ready
                     ??_1_DO:
0000001C    6802                       	LDR             R2,[R0,#0]
0000001E    210C                       	MOVS            R1,#12
00000020    4391                       	BICS            R1,R2
00000022    D1FB                       	BNE             ??_1_DO
;000025            RST_CLK->CPU_CLOCK=0x00000002;                                  //HSE=8 MHz
00000024    2102                       	MOVS            R1,#2
00000026    60C1                       	STR             R1,[R0,#12]
;000026            RST_CLK->PLL_CONTROL=(15/*11*/<<8)|(1<<2);                    //PLL CPU On, PLL_MULL=15. PLLCPUo = PLLCPUi x (PLLCPUMUL+1), т.е. x16
00000028    4910                       	LDR             R1,?lr0003	; 0F04h
0000002A    6041                       	STR             R1,[R0,#4]
;000027            while((RST_CLK->CLOCK_STATUS&0x02)!=0x02);              //wait until PLL CPU not ready
                     ??_2_DO:
0000002C    6801                       	LDR             R1,[R0,#0]
0000002E    07C9                       	LSLS            R1,R1,#31
00000030    D3FC                       	BCC             ??_2_DO
;000028            RST_CLK->PER_CLOCK|=0x08;                                               //EEPROM_CNTRL Clock enable
00000032    69C1                       	LDR             R1,[R0,#28]
00000034    2208                       	MOVS            R2,#8
00000036    4311                       	ORRS            R1,R2
00000038    61C1                       	STR             R1,[R0,#28]
;000029            EEPROM->CMD=3<<3;                                                               //Delay=4
0000003A    2218                       	MOVS            R2,#24
0000003C    490C                       	LDR             R1,?lr0004	; 40018000h
0000003E    600A                       	STR             R2,[R1,#0]
;000030            RST_CLK->PER_CLOCK&=(~0x08);                                    //EEPROM_CNTRL Clock enable
00000040    69C1                       	LDR             R1,[R0,#28]
00000042    2208                       	MOVS            R2,#8
00000044    43D2                       	MVNS            R2,R2
00000046    4011                       	ANDS            R1,R2
00000048    61C1                       	STR             R1,[R0,#28]
;000031            RST_CLK->CPU_CLOCK|=0x00000106; //HCLK=CPU_C3=CPU_C2, CPU_C2=PLLCPUo, CPU_C1=HSE //CPU Clock = 16*8MHz = 128 MHz
0000004A    68C1                       	LDR             R1,[R0,#12]
0000004C    4A09                       	LDR             R2,?lr0005	; 106h
0000004E    4311                       	ORRS            R1,R2
00000050    60C1                       	STR             R1,[R0,#12]
;000032            RST_CLK->ETH_CLOCK=(1<<24)|(3<<28)|(1<<27);             //PHY_CLK_SEL = HSE2, ETH_CLK_EN=1, PHY_CLK_EN=1, ETH_CLK = 25MHz
00000052    4909                       	LDR             R1,?lr0006	; 39000000h
00000054    6341                       	STR             R1,[R0,#52]
;000045            RST_CLK->PER_CLOCK|=(1<<24)|(1<<22);                    //Enable clock for PORTD and PORTB
00000056    69C1                       	LDR             R1,[R0,#28]
00000058    4A08                       	LDR             R2,?lr0007	; 1400000h
0000005A    4311                       	ORRS            R1,R2
0000005C    61C1                       	STR             R1,[R0,#28]
;000059    }
0000005E    4770                       	BX              R14

00000060    40020000	?lr0000	.DCD	40020000h	; used 1 time(s)
