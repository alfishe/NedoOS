               PortConfig??T:
;000106    void PortConfig()
00000080    B530                       	PUSH            {R4,R5,R14} 
;000120            RST_CLK->PER_CLOCK|=(0x1F<<21)|(1<<29); //Enable clock of PORTA, PORTB, PORTC, PORTD, PORTE, PORTF
00000082    4A25                       	LDR             R2,?lr0008	; 4002001Ch
00000084    6810                       	LDR             R0,[R2,#0]
00000086    4925                       	LDR             R1,?lr0009	; 23E00000h
00000088    4308                       	ORRS            R0,R1
0000008A    6010                       	STR             R0,[R2,#0]
;000123            PORTA->FUNC=0x55555555;                 //PORTA - DATA bus
0000008C    4C24                       	LDR             R4,?lr0010	; 55555555h
0000008E    4825                       	LDR             R0,?lr0011	; 400A8008h
00000090    6004                       	STR             R4,[R0,#0]
;000124            PORTA->ANALOG=0xFFFF;                   //PORTA - digital
00000092    4B25                       	LDR             R3,?lr0012	; 0FFFFh
00000094    6043                       	STR             R3,[R0,#4]
;000125            PORTA->PWR=0xFFFFFFFF;                  //PORTA - fast speed
00000096    2100                       	MOVS            R1,#0
00000098    43C9                       	MVNS            R1,R1
0000009A    6101                       	STR             R1,[R0,#16]
;000127            PORTB->FUNC=0x55555555;                 //PORTB - DATA bus
0000009C    4823                       	LDR             R0,?lr0013	; 400B0008h
0000009E    6004                       	STR             R4,[R0,#0]
;000128            PORTB->ANALOG=0xFFFF;                   //PORTB - digital
000000A0    6043                       	STR             R3,[R0,#4]
;000129            PORTB->PWR=0xFFFFFFFF;                  //PORTB - fast speed
000000A2    6101                       	STR             R1,[R0,#16]
;000132            PORTC->FUNC=0x02A80005;                 //PORTC[12..9] - BE3, BE2, BE1, BE0 (инверсные???); PORTC[1..0] - ~RD(~OE), ~WR(~WE)
000000A4    4922                       	LDR             R1,?lr0014	; 2A80005h
000000A6    4823                       	LDR             R0,?lr0015	; 400B8008h
000000A8    6001                       	STR             R1,[R0,#0]
;000133            PORTC->ANALOG=0x1E03;                   //PORTC[12..9], PORTC[1..0] - digital
000000AA    4923                       	LDR             R1,?lr0016	; 1E03h
000000AC    6041                       	STR             R1,[R0,#4]
;000134            PORTC->PWR=0x03FC000F;                  //PORTC - fast speed
000000AE    4923                       	LDR             R1,?lr0017	; 3FC000Fh
000000B0    6101                       	STR             R1,[R0,#16]
;000137            PORTF->FUNC=0xAAAAA800;                 //PORTF[15..5] - ADDRESS bus
000000B2    4923                       	LDR             R1,?lr0018	; 0AAAAA800h
000000B4    4823                       	LDR             R0,?lr0019	; 400E8008h
000000B6    6001                       	STR             R1,[R0,#0]
;000138            PORTF->ANALOG=0xFFE0;                   //PORTF[15..5] - digital
000000B8    4923                       	LDR             R1,?lr0020	; 0FFE0h
000000BA    6041                       	STR             R1,[R0,#4]
;000139            PORTF->PWR=0xFFFFFC00;                  //PORTF - fast speed
000000BC    4923                       	LDR             R1,?lr0021	; 0FFFFFC00h
000000BE    6101                       	STR             R1,[R0,#16]
;000141            PORTD->FUNC=0x80000000;                 //PORTD_15 - ADDRESS[13]
000000C0    4923                       	LDR             R1,?lr0022	; 80000000h
000000C2    4824                       	LDR             R0,?lr0023	; 400C0000h
000000C4    6081                       	STR             R1,[R0,#8]
;000142            PORTD->ANALOG=0x8000;                   //PORTD_15 - digital
000000C6    4924                       	LDR             R1,?lr0024	; 8000h
000000C8    60C1                       	STR             R1,[R0,#12]
;000143            PORTD->PWR=0xC0000000;                  //PORTD - fast speed
000000CA    4924                       	LDR             R1,?lr0025	; 0C0000000h
000000CC    6181                       	STR             R1,[R0,#24]
;000145            PORTE->FUNC=0x00000AAA;                 //PORTE[5..0] - ADDRESS[19..14], PORTE_7 - ADDRESS[21] (или /CS1???),
000000CE    4C24                       	LDR             R4,?lr0026	; 0AAAh
000000D0    4924                       	LDR             R1,?lr0027	; 400C8000h
000000D2    608C                       	STR             R4,[R1,#8]
;000146            PORTE->RXTX=0x0040;                             //PORTE_6=1 (~CS1=1) (или CS0???)
000000D4    2440                       	MOVS            R4,#64
000000D6    600C                       	STR             R4,[R1,#0]
;000147            PORTE->OE=0x00C0;                               //PORTE_6 - Output (и PORTE_7???)
000000D8    25C0                       	MOVS            R5,#0C0h
000000DA    604D                       	STR             R5,[R1,#4]
;000148            PORTE->ANALOG=0x00FF;                   //PORTE[7..0] - digital
000000DC    25FF                       	MOVS            R5,#0FFh
000000DE    60CD                       	STR             R5,[R1,#12]
;000149            PORTE->PWR=0x0000FFFF;                  //PORTE - fast speed
000000E0    618B                       	STR             R3,[R1,#24]
