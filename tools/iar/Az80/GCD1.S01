/* Euclid's Algorithm */
/* Numbers in A and B */
/* Result in B        */

        NAME    gcd
        ORG     1000H

begin   CP      B
        JR      NC,noswap
        LD      C,A
        LD      A,B
        LD      B,C
noswap  SUB     B
        CP      0
        JR      NZ,begin
        RET

        END     begin
