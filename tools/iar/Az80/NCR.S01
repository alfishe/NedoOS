; Test A register
test    MACRO
        OR      A
        ENDM
;        
; Recursive routine to calculate
; binomial coefficients
;
ncr     LD      HL,1
        LD      A,C
        test
        RET     Z
        CP      B       ; B=C?
        RET     Z
        ;
none    DEC     B
        PUSH    BC      ; Save B,C
        CALL    ncr    
        POP     BC      ; Restore B,C
        PUSH    HL      ; Save result
        DEC     C
        CALL    ncr
        POP     BC      ; Get result in BC
        ADD     HL,BC     
        RET
        ;
main    LD      SP,2000
        LD      BC,703H ; Test 3C7
        CALL    ncr
        RET

        END
